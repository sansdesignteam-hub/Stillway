---
/**
 * One pill button for the whole page (after ayocin.com): label + round arrow; on hover or focus the
 * circle widens until it is the pill, and the label turns to the other colour (QA27 HE-09: one arrow,
 * nav.css). `variant` names the pill at rest: 'paper' (light, on light grounds) or 'ink' (dark, on
 * dark grounds); the navbar button follows the header theme. Without `href` it is a <button>.
 */
interface Props {
  [key: string]: unknown;
  href?: string;
  label: string;
  variant?: 'ink' | 'paper';
  class?: string;
  compact?: boolean;
}
const { href, label, variant = 'paper', class: className, compact = false, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['btn', `btn--${variant}`, compact && 'btn--compact', className]} href={href} type={href ? undefined : 'button'} {...rest}>
  <span class="btn__label">{label}</span>
  <span class="btn__icon" aria-hidden="true">
    <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </span>
</Tag>
