---
/**
 * Lockup (Moodboard §4): ring mark (a thin band seen from the front, an ochre dot as the
 * sensor window) + "Stillway" in Geist Medium, tracking −3%. Same lockup in navbar and footer.
 * Placeholder drawing until the Visual Director exports the final mark.
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: cls = '', label = 'Stillway' } = Astro.props;
---

<span class:list={['logo', cls]} aria-label={label} role="img">
  <svg class="logo__mark" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="2.2" />
    <circle cx="12" cy="3.4" r="1.7" fill="var(--ochre)" />
  </svg>
  <span class="logo__word" aria-hidden="true">Stillway</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-sans);
    font-weight: var(--w-medium);
    letter-spacing: var(--track-tight);
    line-height: 1;
  }
  .logo__mark {
    width: 1.05em;
    height: 1.05em;
  }
</style>
