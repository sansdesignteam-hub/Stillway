---
/**
 * Logo: the word "Stillway" only, Geist Medium, tracking −3% (D-083 replaces the ring-mark lockup
 * of D-079).
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: cls = '', label = 'Stillway' } = Astro.props;
---

<span class:list={['logo', cls]} aria-label={label} role="img">
  <span class="logo__word" aria-hidden="true">Stillway</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-sans);
    font-weight: var(--w-medium);
    letter-spacing: var(--track-tight);
    line-height: 1;
  }
  .logo__mark {
    width: 1.05em;
    height: 1.05em;
  }
</style>
