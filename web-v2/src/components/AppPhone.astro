---
/**
 * The phone in S09 (D-159): an app screen in the style of the Ultrahuman app (ultrahuman.com/ring-pro,
 * design/v2/references/s09-ref-uh-*.png) with Stillway's own words, numbers and colours:
 *  - a dark screen lit from above in the mode colour (Heart rate green, Sleep blue, Recovery violet —
 *    the ring's lights, sunk into Night so they read like the reference's maroon / teal, D-159),
 *  - glass cards (large radius, translucent, blurred, a thin light edge) with a small capitals chip,
 *  - big number + small unit + one short status, thin white line charts with ringed end dots and a
 *    dashed reference line, stage bars, a hypnogram, a progress ring, a light beam,
 *  - an iOS status bar (9:41) and a glass tab pill over the phone's lower edge.
 * The three pages cross-fade with a small rise (scripts/sections/app.ts). HTML / CSS / SVG only.
 * Numbers: the website's simulated set (D-066, content/copy.ts app + sleep); a few extra simulated
 * values for the charts are marked below.
 * Placement (D-160): the phone's centre and height come from --p-cx / --p-cy / --ph on the section, so
 * it can later sit inside the Visual Director's hand photo (screen behind the photo's screen hole).
 * `page` (local review only) renders one page.
 */
import { app as d, sleep as s3, activity as s4 } from '../content/copy';

interface Props {
  page?: number;
}
const { page } = Astro.props;

/* ---------- Heart rate (simulated, 00:00 → 21:00 now; resting ≈ 58, peak 82 at 15:30 — copy) ---------- */
const HR = [57, 58.2, 56.7, 55.9, 57.6, 58, 56.2, 56.3, 58, 57.5, 55.8, 56.8, 57.2, 60.1, 62.5, 63.5, 63.6, 64.1, 63, 64.7, 68.3, 68.5, 65, 63, 65.4, 68.7, 68.1, 64.5, 63.1, 66, 74, 82, 67.1, 66.1, 66.7, 67.7, 67.6, 66, 64.1, 63.5, 64.4, 65.3, 64.7];
// a deterministic jitter between the half-hour points, so the day reads as the reference's jagged line
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647) - 0.5;
const fine: number[] = [];
HR.forEach((v, i) => {
  const n = HR[i + 1] ?? v;
  for (let k = 0; k < 3; k++) fine.push(v + ((n - v) * k) / 3 + rnd() * (i > 12 ? 6 : 3));
});
fine.length = (HR.length - 1) * 3 + 1;
fine[fine.length - 1] = HR[HR.length - 1];
const HW = 300;
const HH = 70;
const hx = (i: number) => (i / (fine.length - 1)) * HW;
const hy = (v: number) => HH - 4 - ((v - 50) / 36) * (HH - 8);
const hrPath = fine.map((v, i) => `${i ? 'L' : 'M'}${hx(i).toFixed(1)} ${hy(v).toFixed(1)}`).join(' ');
const hrNow = { x: HW, y: hy(HR[HR.length - 1]) };
const hrRest = hy(58);
// the day's lowest point and the moving minutes (S04 frames: 25 + 15 + 20 min), simulated
const low = Math.round(Math.min(...HR));
const lowAt = HR.indexOf(Math.min(...HR));
const lowTime = `${String(Math.floor(lowAt / 2)).padStart(2, '0')}:${lowAt % 2 ? '30' : '00'}`;
const moving = s4.frames.filter((f) => f.state === 'Moving');
const movingMin = moving.reduce((a, f) => a + parseInt(f.detail, 10), 0);

// resting HR over the week (simulated), a dot chart with a dashed "usual" line
const WEEK = [60, 59, 58.5, 59, 57.5, 58, 58];
const WW = 120;
const WH = 46;
const wx = (i: number) => 6 + (i / 6) * (WW - 12);
const wy = (v: number) => 8 + ((61 - v) / 4) * (WH - 16);
const wkPath = WEEK.map((v, i) => `${i ? 'L' : 'M'}${wx(i).toFixed(1)} ${wy(v).toFixed(1)}`).join(' ');
const wkArea = `${wkPath} L${wx(6).toFixed(1)} ${WH} L${wx(0).toFixed(1)} ${WH} Z`;

// peak ring: 82 of a 100 bpm scale (simulated scale)
const RING_C = 2 * Math.PI * 15;

/* ---------- Sleep (D-066: 23:10 → 06:22, 7h 12m; Deep 84, REM 96, Light 252 min; broken 2×) ---------- */
const stages = d.sleep.stages;
const total = stages.reduce((a, s) => a + s.min, 0);
const pctOf = (m: number) => Math.round((m / total) * 100);
const order = [stages[1], stages[2], stages[0]]; // REM, Light, Deep (reference order, lightest first)
// the night in order (simulated): stage + minutes; the two short wakes are the "Broken 2×" of S03
const NIGHT: Array<[string, number]> = [
  ['L', 20], ['D', 35], ['L', 15], ['R', 15], ['A', 3], ['L', 30], ['D', 30], ['L', 20], ['R', 25], ['L', 40], ['D', 19], ['L', 25], ['R', 28], ['A', 4], ['L', 50], ['R', 28], ['L', 52],
];
const nightMin = NIGHT.reduce((a, [, m]) => a + m, 0);
const LEVEL: Record<string, number> = { A: 0, R: 1, L: 2, D: 3 };
const YW = 300;
const YH = 64;
let t0 = 0;
const hyp = NIGHT.map(([st, m]) => {
  const x = (t0 / nightMin) * YW;
  const w = (m / nightMin) * YW;
  t0 += m;
  return { st, x, w, y: 4 + LEVEL[st] * ((YH - 12) / 3) };
});
// the timeline: settled → up with the two wakes as gaps
let tw = 0;
const wakes = NIGHT.flatMap(([st, m]) => {
  const at = tw;
  tw += m;
  return st === 'A' ? [{ x: (at / nightMin) * 100, w: Math.max(1.6, (m / nightMin) * 100) }] : [];
});

/* ---------- Recovery (D-066 bars; HRV ms = bar × 80, simulated) ---------- */
const hrv = d.recovery.bars.map((b) => Math.round(b * 80));
const today = hrv[hrv.length - 1];
const hrvMid = Math.round(hrv.reduce((a, v) => a + v, 0) / hrv.length);
const VW = 150;
const vx = (i: number) => 6 + (i / 6) * (VW - 12);
const vy = (v: number) => 8 + ((70 - v) / 30) * (WH - 16);
const hrvPath = hrv.map((v, i) => `${i ? 'L' : 'M'}${vx(i).toFixed(1)} ${vy(v).toFixed(1)}`).join(' ');
---

<div class="ap__phone" data-p-phone data-a data-only={page}>
  <div class="ap__screen" data-p-screen>
    <!-- the light of each mode, cross-faded by app.ts -->
    <i class="ap__glow ap__glow--green" data-p-glow="0" aria-hidden="true"></i>
    <i class="ap__glow ap__glow--blue" data-p-glow="1" aria-hidden="true"></i>
    <i class="ap__glow ap__glow--violet" data-p-glow="2" aria-hidden="true"></i>

    <div class="ap__status" aria-hidden="true">
      <span class="ap__clock">9:41</span>
      <i class="ap__island"></i>
      <span class="ap__icons">
        <svg viewBox="0 0 17 11" class="ap__sig"><rect x="0" y="7" width="3" height="4" rx="0.8"></rect><rect x="4.6" y="5" width="3" height="6" rx="0.8"></rect><rect x="9.2" y="2.6" width="3" height="8.4" rx="0.8"></rect><rect x="13.8" y="0" width="3" height="11" rx="0.8"></rect></svg>
        <svg viewBox="0 0 15 11" class="ap__wifi"><path d="M7.5 10.6 5.3 8.3a3.1 3.1 0 0 1 4.4 0Z"></path><path d="M3.4 6.4a5.8 5.8 0 0 1 8.2 0l-1.1 1.1a4.3 4.3 0 0 0-6 0Z"></path><path d="M1.2 4.2a8.9 8.9 0 0 1 12.6 0l-1.1 1.1a7.4 7.4 0 0 0-10.4 0Z"></path></svg>
        <svg viewBox="0 0 26 12" class="ap__batt"><rect x="0.5" y="0.5" width="22" height="11" rx="3.2" fill="none" stroke-opacity="0.45"></rect><rect x="2.2" y="2.2" width="16" height="7.6" rx="1.8"></rect><path d="M24 4v4a2 2 0 0 0 0-4Z" fill-opacity="0.45"></path></svg>
      </span>
    </div>

    <div class="ap__pages" data-p-pages>
      <!-- 1 · Heart rate (reference: vitals) -->
      <section class="ap__page" data-p-page="0" data-a aria-label="Heart rate, simulated data">
        <div class="ap__pin" data-p-pin>
          <article class="ap__card" data-p-card>
            <p class="ap__chip">Heart rate</p>
            <p class="ap__big"><span data-n="58">58</span><span class="ap__unit ap__unit--caps">{d.heart.unit}</span></p>
            <p class="ap__stat">{d.heart.label} · through the day</p>
            <div class="ap__hrwrap">
              <svg class="ap__hr" data-draw viewBox={`0 0 ${HW} ${HH}`} preserveAspectRatio="none" aria-hidden="true">
                <line x1="0" x2={HW} y1={hrRest} y2={hrRest} class="ap__ref"></line>
                <path d={hrPath} class="ap__jag"></path>
              </svg>
              <i class="ap__end" data-end style={`top:${((hrNow.y / HH) * 100).toFixed(2)}%`} aria-hidden="true"></i>
            </div>
            <p class="ap__axis" aria-hidden="true"><span>00:00</span><span>Now</span></p>
          </article>
          <div class="ap__row">
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Peak</p>
              <p class="ap__mid"><span data-n="82">82</span><span class="ap__unit ap__unit--caps">bpm</span></p>
              <p class="ap__stat">15:30 · stairs</p>
              <svg class="ap__ring" viewBox="0 0 40 40" aria-hidden="true">
                <circle cx="20" cy="20" r="15" class="ap__ring-track"></circle>
                <circle cx="20" cy="20" r="15" class="ap__ring-arc" data-ring="0.82" data-len={RING_C.toFixed(2)} stroke-dasharray={`${(RING_C * 0.82).toFixed(2)} ${RING_C.toFixed(2)}`}></circle>
              </svg>
            </article>
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Resting HR</p>
              <p class="ap__mid"><span data-n="58">58</span><span class="ap__unit ap__unit--caps">bpm</span></p>
              <p class="ap__stat">This week</p>
              <div class="ap__dotwrap">
                <svg class="ap__dots" data-draw viewBox={`0 0 ${WW} ${WH}`} aria-hidden="true">
                  <line x1="0" x2={WW} y1={wy(58.6)} y2={wy(58.6)} class="ap__ref"></line>
                  <path d={wkArea} class="ap__area"></path>
                  <path d={wkPath} class="ap__thin"></path>
                  {WEEK.map((v, i) => i < 6 && <circle cx={wx(i)} cy={wy(v)} r="1.9" class="ap__pt" />)}
                  <circle cx={wx(6)} cy={wy(WEEK[6])} r="3.2" class="ap__pt ap__pt--end" />
                </svg>
              </div>
            </article>
          </div>
          <article class="ap__card" data-p-card>
            <p class="ap__chip">HRV</p>
            <div class="ap__split">
              <div>
                <p class="ap__mid"><span data-n={String(today)}>{today}</span><span class="ap__unit ap__unit--caps">ms</span></p>
                <p class="ap__stat">Last night</p>
              </div>
              <svg class="ap__dots ap__dots--wide" data-draw viewBox={`0 0 ${VW} ${WH}`} aria-hidden="true">
                <line x1="0" x2={VW} y1={vy(hrvMid)} y2={vy(hrvMid)} class="ap__ref"></line>
                <path d={hrvPath} class="ap__thin"></path>
                {hrv.map((v, i) => i < 6 && <circle cx={vx(i)} cy={vy(v)} r="1.9" class="ap__pt" />)}
                <circle cx={vx(6)} cy={vy(today)} r="3.2" class="ap__pt ap__pt--end" />
              </svg>
            </div>
          </article>
          <div class="ap__row">
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Lowest</p>
              <p class="ap__mid"><span data-n={String(low)}>{low}</span><span class="ap__unit ap__unit--caps">bpm</span></p>
              <p class="ap__stat">{lowTime} · asleep</p>
            </article>
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Moving</p>
              <p class="ap__mid"><span data-n={String(movingMin)}>{movingMin}</span><span class="ap__unit">min</span></p>
              <p class="ap__stat">{moving.length} times today</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 2 · Sleep (reference: sleep) -->
      <section class="ap__page" data-p-page="1" data-a aria-label="Sleep, simulated data">
        <div class="ap__pin" data-p-pin>
          <article class="ap__card" data-p-card>
            <p class="ap__chip">Sleep</p>
            <p class="ap__big"><span data-n={d.sleep.h}>{d.sleep.h}</span><span class="ap__unit">h</span> <span data-n={d.sleep.m}>{d.sleep.m}</span><span class="ap__unit">m</span></p>
            <p class="ap__stat">{s3.stats[1].tag} · broken {s3.stats[2].value}</p>
            <div class="ap__timeline" data-draw aria-hidden="true">
              <i class="ap__tl-line"></i>
              {wakes.map((w) => <i class="ap__tl-gap" style={`left:${w.x.toFixed(2)}%;width:${w.w.toFixed(2)}%`} />)}
              <i class="ap__tl-end ap__tl-end--a"></i>
              <i class="ap__tl-end ap__tl-end--b"></i>
            </div>
            <p class="ap__axis"><span>Settled 23:10</span><span>Up 06:22</span></p>
          </article>
          <article class="ap__card" data-p-card>
            <p class="ap__ctitle">Sleep stages</p>
            <ul class="ap__stages">
              {
                order.map((st) => (
                  <li>
                    <span class="ap__strack">
                      <span class={`ap__sbar ap__sbar--${st.name.toLowerCase()}`} data-bar style={`width:${pctOf(st.min)}%`}>
                        {st.name}
                      </span>
                    </span>
                    <span class="ap__spct"><span data-n={String(pctOf(st.min))}>{pctOf(st.min)}</span>%</span>
                  </li>
                ))
              }
            </ul>
            <p class="ap__small">Deep sleep · {stages[0].d}</p>
            <svg class="ap__hyp" data-draw viewBox={`0 0 ${YW} ${YH}`} preserveAspectRatio="none" aria-hidden="true">
              {hyp.map((h, i) => i > 0 && <line x1={h.x} x2={h.x} y1={Math.min(h.y, hyp[i - 1].y) + 3} y2={Math.max(h.y, hyp[i - 1].y) + 3} class="ap__hyp-join" />)}
              {hyp.map((h) => <rect x={h.x} y={h.y} width={Math.max(1.4, h.w)} height="6" rx="1.2" class={`ap__hyp-${h.st}`} />)}
            </svg>
            <p class="ap__axis" aria-hidden="true"><span>23:10</span><span>06:22</span></p>
          </article>
          <div class="ap__row">
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">{s3.stats[0].tag}</p>
              <p class="ap__mid">{s3.stats[0].value}</p>
              <p class="ap__stat">Bedtime</p>
            </article>
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Up</p>
              <p class="ap__mid">06:22</p>
              <p class="ap__stat">Wake-up</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 3 · Recovery (reference: the age screen) -->
      <section class="ap__page" data-p-page="2" data-a aria-label="Recovery, simulated data">
        <div class="ap__pin" data-p-pin>
          <article class="ap__hero" data-p-card>
            <p class="ap__htitle">Recovery</p>
            <p class="ap__huge"><span data-n={String(today)}>{today}</span><span class="ap__unit ap__unit--caps">ms</span></p>
            <p class="ap__hchip">{d.recovery.line}</p>
            <p class="ap__small">HRV today, against your week.</p>
          </article>
          <i class="ap__beam" data-beam aria-hidden="true"></i>
          <p class="ap__pill-label" data-p-card>This week</p>
          <article class="ap__card" data-p-card>
            <p class="ap__chip">{d.recovery.title}</p>
            <div class="ap__week" aria-hidden="true">
              {
                hrv.map((v, i) => (
                  <span class={i === hrv.length - 1 ? 'is-today' : ''}>
                    <em>{v}</em>
                    <i class="ap__wcol">
                      <b data-grow style={`height:${(((d.recovery.bars[i] - 0.45) / 0.35) * 70 + 30).toFixed(0)}%`} />
                    </i>
                    <small>{d.recovery.days[i][0]}</small>
                  </span>
                ))
              }
            </div>
          </article>
          <div class="ap__row">
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Resting HR</p>
              <p class="ap__mid"><span data-n="58">58</span><span class="ap__unit ap__unit--caps">bpm</span></p>
              <p class="ap__stat">This week</p>
            </article>
            <article class="ap__card ap__card--half" data-p-card>
              <p class="ap__chip">Sleep</p>
              <p class="ap__mid"><span data-n={d.sleep.h}>{d.sleep.h}</span><span class="ap__unit">h</span> <span data-n={d.sleep.m}>{d.sleep.m}</span><span class="ap__unit">m</span></p>
              <p class="ap__stat">Last night</p>
            </article>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- glass tab pill over the phone's lower edge; follows the scroll (labels, not buttons) -->
  <nav class="ap__tabs" aria-hidden="true">
    <i class="ap__tab-on" data-p-tabon></i>
    {d.states.map((st, i) => <span data-p-tab={i}>{st.label}</span>)}
  </nav>
</div>

<style>
  /* The screen texts scale with the phone (--u = 1 % of its height), like a real screenshot; they
     match no fixed text style (reported, as before). Geist only (D-156). */
  .ap__phone {
    --u: calc(var(--ph) / 100);
    --pw: calc(var(--ph) * 0.485);
    --t-xs: max(8px, calc(var(--u) * 1.45));
    --t-s: max(9px, calc(var(--u) * 1.7));
    --t-m: max(10px, calc(var(--u) * 2));
    --r-card: calc(var(--u) * 2.6);
    /* D-160: placed by its centre (section vars), so the hand photo can take over the bezel later */
    position: absolute;
    left: var(--p-cx, 50%);
    top: var(--p-cy, 50%);
    width: var(--pw);
    height: var(--ph);
    margin: calc(var(--ph) / -2) 0 0 calc(var(--pw) / -2);
    padding: calc(var(--u) * 1.2);
    border-radius: calc(var(--u) * 7.5);
    background: var(--ink);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--white) 10%, transparent) inset,
      0 18px 40px -12px color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .ap__screen {
    position: relative;
    height: 100%;
    border-radius: calc(var(--u) * 6.3);
    background: var(--night);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    color: var(--white);
    isolation: isolate;
  }
  /* the mode light: from above, sunk into Night (D-159), with a faint bounce from below */
  .ap__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 55% at 50% -6%, color-mix(in srgb, var(--c) 34%, var(--night)) 0%, color-mix(in srgb, var(--c) 12%, var(--night)) 45%, transparent 75%),
      radial-gradient(90% 30% at 50% 108%, color-mix(in srgb, var(--c) 16%, var(--night)), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--c) 10%, var(--night)), var(--night) 70%);
    will-change: opacity;
  }
  .ap__glow--green {
    --c: var(--led-heart-rate);
  }
  .ap__glow--blue,
  .ap__page[data-p-page='1'] {
    --c: var(--led-sleep);
  }
  .ap__glow--violet,
  .ap__page[data-p-page='2'] {
    --c: var(--led-recovery);
  }
  .ap__page[data-p-page='0'] {
    --c: var(--led-heart-rate);
  }

  /* iOS status bar */
  .ap__status {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--u) * 1.9) calc(var(--u) * 3.6) calc(var(--u) * 1.4) calc(var(--u) * 4.2);
    font-size: max(10px, calc(var(--u) * 1.9));
    font-weight: var(--w-label);
    font-variant-numeric: tabular-nums;
  }
  .ap__island {
    position: absolute;
    left: 50%;
    top: calc(var(--u) * 1.3);
    width: 31%;
    height: calc(var(--u) * 3.4);
    translate: -50% 0;
    border-radius: 99px;
    background: var(--black, #000);
  }
  .ap__icons {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.6);
  }
  .ap__icons svg {
    height: calc(var(--u) * 1.25);
    width: auto;
    fill: var(--white);
  }
  .ap__icons .ap__batt {
    height: calc(var(--u) * 1.35);
  }
  .ap__batt rect:first-child {
    stroke: var(--white);
  }

  .ap__pages {
    position: relative;
    overflow: hidden;
    /* content slides away under the status bar softly, as in an app */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 calc(var(--u) * 1.6), #000 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 calc(var(--u) * 1.6), #000 100%);
  }
  .ap__page {
    position: absolute;
    inset: 0;
    will-change: opacity;
  }
  /* the page content; app.ts scrolls it up like a real app (D-161), padded so its end clears the pill */
  .ap__pin {
    padding: calc(var(--u) * 0.6) calc(var(--u) * 1.8) calc(var(--u) * 9);
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 1.3);
    will-change: transform;
  }
  .ap__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 1.3);
  }

  /* glass card: translucent, blurred, a thin light edge, large radius */
  .ap__card,
  .ap__hero {
    position: relative;
    border-radius: var(--r-card);
    padding: calc(var(--u) * 1.6) calc(var(--u) * 1.7) calc(var(--u) * 1.7);
    background: linear-gradient(180deg, color-mix(in srgb, var(--white) 9%, transparent), color-mix(in srgb, var(--white) 4%, transparent));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--white) 10%, transparent) inset,
      0 1px 0 0 color-mix(in srgb, var(--white) 14%, transparent) inset;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 0.5);
    will-change: transform, opacity;
  }
  .ap__chip {
    justify-self: start;
    padding: calc(var(--u) * 0.35) calc(var(--u) * 0.9);
    border-radius: 99px;
