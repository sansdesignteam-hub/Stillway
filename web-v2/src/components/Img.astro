---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  /** eager load without high priority (stage images that must be ready when scrolled to) */
  ready?: boolean;
  fallbackFormat?: 'jpg' | 'png';
  class?: string;
  [key: string]: unknown;
}
const { src, alt, sizes, widths, eager = false, ready = false, fallbackFormat = 'jpg', class: className, ...rest } = Astro.props;
const w = (widths ?? [480, 768, 1080, 1440, 1920]).filter((n) => n <= src.width).concat(
  widths ? [] : [src.width],
);
const uniq = [...new Set(w)].sort((a, b) => a - b);
---

<Picture
  src={src}
  alt={alt}
  widths={uniq}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat={fallbackFormat}
  quality={78}
  loading={eager || ready ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={className}
  {...rest}
/>
