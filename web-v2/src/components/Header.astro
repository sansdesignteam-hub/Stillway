---
/**
 * Navbar V2 in the V1 style (D-075; copied from web/src/components/Header.astro, D-038/D-053):
 * lockup · round home tile · one rounded translucent bar (links with dividers, time-of-day
 * clock, compact CTA). Phone: lockup + bar (clock + CTA arrow) + burger that opens the
 * sensiq-style panel. Content is V2: links and "Find your size" (D-069), Hanken Grotesk clock (D-156).
 * The bar tint follows the surface underneath (data-theme light | dark, set by story.ts).
 */
import lockup from '../assets/stillway-lockup-03a.svg?raw';
import Button from './Button.astro';
import { nav } from '../content/copy';
import { sections } from '../content/sections';
const first = sections[0];
---

<header class="site-header" data-nav data-theme="light">
  <div class="site-header__inner">
    <a class="wordmark" href="#top" aria-label="Stillway, back to top"><span class="wordmark__lockup" aria-hidden="true" set:html={lockup} /></a>

    <button class="nav-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
    </button>

    <a class="nav-home" href="#top" aria-label="Back to top">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3.5 9.2 10 3.8l6.5 5.4V16a.8.8 0 0 1-.8.8h-3.6v-4.6H7.9v4.6H4.3a.8.8 0 0 1-.8-.8Z" fill="currentColor"></path></svg>
    </a>

    <div class="nav-bar">
      <nav class="site-nav" aria-label="Main">
        <ul>
          {nav.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="nav-bar__end">
        <p class="clock" aria-hidden="true">
          <span class="clock__time" data-clock-time>{first.time}</span>
          <span class="clock__part" data-clock-part>Morning</span>
        </p>
        <Button href={nav.cta.href} label={nav.cta.label} compact class="nav-cta" />
      </div>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu__backdrop" data-menu-close></div>
  <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button class="menu__close" type="button" aria-label="Close menu" data-menu-close>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </button>
    <ul class="menu__list">
      <li style="--i:0"><a href="#top" data-menu-link>Home</a></li>
      {nav.links.map((l, i) => (
        <li style={`--i:${i + 1}`}><a href={l.href} data-menu-link>{l.label}</a></li>
      ))}
    </ul>
    <div class="menu__cta" style={`--i:${nav.links.length + 1}`}>
      <Button href={nav.cta.href} label={nav.cta.label} variant="ink" data-menu-link />
    </div>
  </div>
</div>
