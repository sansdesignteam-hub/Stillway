---
/**
 * S10 Finishes & pricing — 22:00 · Sand (D-098, D-099). References (Figma sticky 40004118:141):
 *  - Mirelz viewer → state 1: the visitor turns the ring 360° (drag / swipe, ‹ › buttons, a small
 *    "Drag to turn" hint); it only turns, no zoom, and eases back to its start pose when left alone.
 *  - Shift PDP → the panel on the right: name, price, Finish swatches with labels under them, Size as
 *    boxes 6–13, one full-width button, one small line under it; plenty of room.
 *  - Ultrahuman PDP → a swatch changes the real material (finishes.json *_polished, D-085), with a
 *    Daylight / Lamp light toggle; the panel warms a little under Lamp light.
 * Finish changes only by click (D-069). The button shows an inline note (role="status"), no cart
 * (D-074). CTA = btn-primary (Ink), hover btn-primary-hover (D-134). Motion and controls: scripts/sections/finishes.ts.
 */
import { finishes as d } from '../../content/copy';
---

<section class="scene scene--finishes" data-scene="finishes" aria-labelledby="finishes-title" data-lamp="0">
  <!-- Lamp light (D-100): Sand dims toward a warm evening tone, a low lamp glow on the lamp side -->
  <div class="scene__back"><div class="fn__dim" aria-hidden="true"></div></div>
  <!-- reduced motion / no WebGL: the polished still of the chosen finish -->
  <img class="ring-fallback fn__fb" src={d.finishes[0].still} alt="" width="1024" height="1024" data-ring-fallback data-fn-still data-a loading="lazy" decoding="async" />

  <div class="scene__front">
    <h2 id="finishes-title" class="fn__heads">
      {
        d.heads.map((h, i) => (
          <span class="fn__head" data-fn-head={i} data-a>
            {h}{' '}
          </span>
        ))
      }
    </h2>

    <!-- the viewer: drag / swipe area over the ring (horizontal turns it, vertical still scrolls) -->
    <div class="fn__drag" data-fn-drag aria-hidden="true"></div>
    <div class="fn__turn" data-fn-turn data-a>
      <button type="button" class="fn__arrow" data-fn-prev aria-label={d.prev}>‹</button>
      <span class="fn__hint"><span class="fn__hint-d">{d.hint.desktop}</span><span class="fn__hint-m">{d.hint.mobile}</span></span>
      <button type="button" class="fn__arrow" data-fn-next aria-label={d.next}>›</button>
    </div>

    <!-- Shift PDP panel -->
    <div class="fn__panel" data-fn-panel data-a>
      <div class="fn__top">
        <p class="fn__name">{d.name}</p>
        <p class="fn__price">{d.price}</p>
      </div>
      <p class="fn__muted">{d.priceLine}</p>

      <div class="fn__group" role="group" aria-labelledby="fn-finish-label">
        <p class="fn__label" id="fn-finish-label">{d.finishLabel}: <b data-fn-finish-name>{d.finishes[0].name}</b></p>
        <div class="fn__swatches">
          {
            d.finishes.map((f, i) => (
              <button type="button" class={`fn__swatch fn__swatch--${f.name.toLowerCase()}`} data-fn-swatch={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <i aria-hidden="true" />
                <span>{f.name}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="fn__group" role="group" aria-label={d.light.label}>
        <div class="fn__seg">
          <button type="button" data-fn-light="0" aria-pressed="true">{d.light.day}</button>
          <button type="button" data-fn-light="1" aria-pressed="false">{d.light.lamp}</button>
        </div>
      </div>

      <!-- state 4: size, box, trial and the one button -->
      <div class="fn__more" data-fn-more data-a>
        <div class="fn__group" role="group" aria-labelledby="fn-size-label">
          <p class="fn__label" id="fn-size-label">{d.sizeLabel}<span data-fn-size-name></span></p>
          <p class="fn__muted">{d.sizeLine}</p>
          <div class="fn__sizes">
            {
              d.sizes.map((n) => (
                <button type="button" data-fn-size={n} aria-pressed="false">
                  {n}
                </button>
              ))
            }
          </div>
        </div>
        <p class="fn__muted fn__box">{d.trial} · {d.box}</p>
        <button type="button" class="fn__cta" data-fn-cta>{d.button(d.finishes[0].name)}</button>
        <p class="fn__note" data-fn-note role="status" aria-live="polite"></p>
      </div>
    </div>
    <p class="sr-only">{d.alt}</p>
  </div>
</section>

<style>
  .scene--finishes {
    color: var(--ink);
    --panel: color-mix(in srgb, var(--paper) 60%, transparent);
  }
  .scene--finishes[data-lamp='1'] {
    --panel: color-mix(in srgb, var(--paper) 86%, var(--cocoa-300) 14%);
  }
  .fn__dim {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    background:
      radial-gradient(55% 70% at 4% 34%, color-mix(in srgb, var(--cocoa-300) 32%, transparent), transparent 70%),
      color-mix(in srgb, var(--night) 72%, var(--cocoa-400) 28%);
  }
  .scene--finishes[data-lamp='1'] .fn__dim {
    opacity: 0.17;
  }
  .scene--finishes .fn__panel {
    transition: background 0.6s ease;
  }
  :global(html.reduced) .scene--finishes .fn__dim,
  :global(html.reduced) .scene--finishes .fn__panel {
    transition: none;
  }
  .fn__fb {
    left: 32%;
    width: min(40vw, calc(70 * var(--lvh)));
  }
  .fn__heads {
    position: absolute;
    left: var(--margin);
    top: var(--content-top);
    width: min(46rem, 58vw);
    /* Heading/Heading 1 */
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
  }
  .fn__head {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }
  /* the drag area covers the ring's half of the screen; touch-action keeps vertical page scroll */
  .fn__drag {
    position: absolute;
    left: 0;
    top: calc(var(--header-h) + calc(16 * var(--lvh)));
    width: 62vw;
    bottom: calc(12 * var(--lvh));
    pointer-events: auto;
    touch-action: pan-y;
    cursor: grab;
  }
  .fn__drag:active {
    cursor: grabbing;
  }
  .fn__turn {
    position: absolute;
    left: 32%;
    bottom: var(--content-bottom);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    /* Paragraph/Small */
    font-size: var(--t-para-sm-size);
    line-height: var(--t-para-sm-lh);
    letter-spacing: var(--t-para-sm-ls);
  }
  .fn__arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-label-lg-size); /* arrow glyph in a round button: Label/Large size, line height 1 to centre it */
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }
  .fn__arrow:hover {
    background: color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .fn__hint-m {
    display: none;
  }
  /* Shift PDP panel */
  .fn__panel {
    position: absolute;
    right: var(--margin);
    top: var(--content-top);
    width: min(30rem, 36vw);
    max-height: calc(calc(100 * var(--svh)) - var(--content-top) - var(--content-bottom));
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-m);
    background: var(--panel);
    transition: background 0.6s ease;
    display: grid;
    gap: 16px;
    align-content: start;
    pointer-events: auto;
  }
  .fn__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  /* Heading/Heading 2 */
  .fn__name {
    font-weight: var(--w-heading);
    font-size: var(--t-heading-2-size);
    line-height: var(--t-heading-2-lh);
    letter-spacing: var(--t-heading-2-ls);
  }
  /* Heading/Heading 3 */
  .fn__price {
    font-weight: var(--w-heading);
    font-size: var(--t-heading-3-size);
    line-height: var(--t-heading-3-lh);
    letter-spacing: var(--t-heading-3-ls);
    font-variant-numeric: tabular-nums;
  }
  /* D-098 r1: readable at desktop, Stone darkened toward Ink — Paragraph/Medium */
  .fn__muted {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    color: color-mix(in srgb, var(--ink) 78%, transparent);
  }
  .fn__group {
    display: grid;
    gap: var(--space-2);
  }
  /* Paragraph/Medium; the finish name in it = Label/Medium (same size, Medium weight) */
  .fn__label {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
  }
  .fn__label b {
    font-weight: var(--w-label);
  }
  .fn__swatches {
    display: flex;
    gap: var(--space-4);
  }
  .fn__swatch {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    /* Paragraph/Small */
    font-size: var(--t-para-sm-size);
    line-height: var(--t-para-sm-lh);
    letter-spacing: var(--t-para-sm-ls);
    color: color-mix(in srgb, var(--ink) 78%, transparent);
    cursor: pointer;
  }
  .fn__swatch i {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent);
    outline: 1.5px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.2s;
  }
  .fn__swatch[aria-pressed='true'] i {
    outline-color: var(--ink);
  }
  .fn__swatch[aria-pressed='true'] {
    color: var(--ink);
  }
  /* product finishes (material, not UI colour) */
  .fn__swatch--silver {
    --sw: var(--finish-silver);
  }
  .fn__swatch--black {
    --sw: var(--finish-black);
  }
  .fn__swatch--gold {
    --sw: var(--finish-gold);
  }
  .fn__seg {
    display: flex;
    gap: var(--space-2);
    padding: 4px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    justify-self: start;
  }
  .fn__seg button {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    font: inherit;
    /* Buttons/Small */
    font-weight: var(--w-label);
    font-size: var(--t-btn-sm-size);
    line-height: var(--t-btn-sm-lh);
    letter-spacing: var(--t-btn-sm-ls);
    color: color-mix(in srgb, var(--ink) 78%, transparent);
    cursor: pointer;
  }
  .fn__seg button[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }
  .fn__more {
    display: grid;
    gap: 16px;
  }
  .fn__sizes {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: var(--space-2);
  }
  .fn__sizes button {
    height: 40px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    background: transparent;
    font: inherit;
    /* Buttons/Small */
    font-weight: var(--w-label);
    font-size: var(--t-btn-sm-size);
    line-height: var(--t-btn-sm-lh);
    letter-spacing: var(--t-btn-sm-ls);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .fn__sizes button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--paper);
  }
  .fn__cta {
    width: 100%;
    height: 52px;
    border-radius: var(--radius-pill);
    border: 0;
    background: var(--ink); /* btn-primary */
    color: var(--paper);
    font: inherit;
    /* Buttons/Medium */
    font-weight: var(--w-label);
    font-size: var(--t-btn-md-size);
    line-height: var(--t-btn-md-lh);
    letter-spacing: var(--t-btn-md-ls);
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s;
  }
  .fn__cta:hover {
    background: var(--btn-primary-hover);
  }
  .fn__cta:active {
    transform: scale(0.99);
  }
  .fn__note {
    min-height: 1.4em;
    /* Paragraph/Small */
    font-size: var(--t-para-sm-size);
    line-height: var(--t-para-sm-lh);
    letter-spacing: var(--t-para-sm-ls);
    text-align: center;
    color: var(--ink);
  }
  .scene--finishes button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  /* QA27 M-15: tablets — the panel and everything in it fit inside the screen, with the same margin
     right as left; the heading takes the room left of it and the sizes wrap to two rows */
  @media (min-width: 720px) and (max-width: 1023px) {
    .fn__panel {
      width: 42vw;
      grid-template-columns: minmax(0, 1fr);
      padding-inline: var(--space-5);
    }
    .fn__top {
      flex-wrap: wrap;
      column-gap: var(--space-3);
    }
    .fn__heads {
      width: calc(58vw - 3 * var(--margin));
      text-wrap: balance;
    }
    .fn__sizes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* from 900 px the eight sizes fit one row again */
  @media (min-width: 900px) and (max-width: 1023px) {
    .fn__sizes {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: var(--space-1);
    }
  }
  /* short tablet screens: tighter, so the button and its note stay inside the panel */
  @media (min-width: 720px) and (max-width: 1023px) and (max-height: 760px) {
    .fn__panel {
      padding-block: var(--space-4);
      gap: 10px;
    }
    .fn__more {
      gap: 10px;
    }
    .fn__sizes button {
      height: 32px;
    }
    .fn__swatch i {
      width: 32px;
      height: 32px;
    }
    .fn__cta {
      height: 44px;
    }
    /* as on phones: the chosen finish is named above, the swatch names stay for screen readers */
    .fn__swatch span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .fn__muted {
      font-size: var(--t-para-sm-size);
      line-height: var(--t-para-sm-lh);
    }
    .fn__note:empty {
      min-height: 0;
    }
  }
  /* D-171: phones — one column in plain scroll flow (title, ring, arrows, panel), as tall as its
     content; finishes.ts moves it 1:1 with the page and sizes the track to it. No pin, no fade. */
  @media (max-width: 719px) {
    .scene--finishes .scene__front {
      bottom: auto;
      overflow: visible;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: calc(var(--header-h) + var(--space-4)) var(--space-3) var(--space-5);
      will-change: transform;
    }
    .fn__fb {
      left: 50%;
      top: 0;
      translate: -50% 0;
      width: 60vw;
    }
    .fn__heads {
      position: static;
      margin: 0;
      width: auto;
      padding-inline: calc(var(--margin) - var(--space-3));
    }
    .fn__head {
      position: static;
    }
    .fn__head[data-fn-head='0'] {
      display: none;
    }
    .fn__drag {
      position: relative;
      inset: auto;
      flex: none;
      width: auto;
      height: min(calc(42 * var(--lvh)), 320px);
    }
    .fn__turn {
      position: static;
      translate: none;
      align-self: center;
      margin-top: calc(-1 * var(--space-2));
    }
    .fn__hint-d {
      display: none;
    }
    .fn__hint-m {
      display: inline;
    }
    .fn__arrow {
      width: 36px;
      height: 36px;
    }
    .fn__panel {
      position: static;
      width: auto;
      max-height: none;
      padding: var(--space-4) var(--space-4) var(--space-3);
      gap: 8px;
    }
    .fn__more {
      gap: 8px;
    }
    .fn__group {
      gap: var(--space-2);
    }
    .fn__muted {
      font-size: var(--t-para-sm-size);
      line-height: var(--t-para-sm-lh);
    }
    .fn__swatches {
      gap: 16px;
    }
    .fn__swatch i {
      width: 30px;
      height: 30px;
    }
    /* the chosen finish is named above; the swatch names stay for screen readers */
    .fn__swatch span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .fn__seg button {
      padding: var(--space-1) var(--space-3);
    }
    .fn__note:empty {
      min-height: 0;
    }
    .fn__sizes button {
      height: 36px;
    }
    .fn__cta {
      height: 46px;
    }
  }
  /* QA27 M-15: large phones / small tablets (the one-column layout) keep a 24 px margin */
  @media (min-width: 600px) and (max-width: 719px) {
    .scene--finishes .scene__front {
      padding-inline: var(--space-5);
    }
  }
</style>
