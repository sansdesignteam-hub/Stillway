---
/**
 * S05 Daily insight — 17:30 · Dusk (D-142; Figma Design S05 State 1–4 40004260:709 / :745 / :781 /
 * :827, card component "Card / Last night" 40004260:693).
 *  - Dusk ground = Night with a soft --cocoa-300 light from the lower left and a shade upper right
 *    (Stage .stage__dusk, painted by story.ts; D-139 colour instead of the Figma ochre)
 *  - State 1: [ 17:30 · DAILY INSIGHT ] + "Everything it noticed." bottom left, ring right-centre
 *  - State 2: the ring grows, the text moves down to the edge and dims, "One calm view." joins
 *  - State 3: the camera goes into the opening; the glass card starts to show (≈ 45%)
 *  - State 4: the glass card (432 px, columns 5–8) fully legible + one small paragraph under it
 * The card is real HTML (selectable): glass (backdrop blur), LAST NIGHT chip, SIMULATED DATA,
 * 7h 12m, the night line chart (Figma SVGs in public/insight), settled / up, divider, one sentence.
 * Motion: scripts/sections/insight.ts.
 */
import { insight as d } from '../../content/copy';
const c = d.card;
const [settled, up] = c.line.split(' · ');
---

<section class="scene scene--insight" data-scene="insight" aria-labelledby="insight-title">
  <div class="scene__back">
    <!-- the warm light behind the glass card, inside the ring's opening (Figma "Glass light"; D-139 colour) -->
    <canvas class="ins__glow" data-i-glow data-a aria-hidden="true"></canvas>
  </div>
  <div class="scene__front">
    <div class="ins__text" data-i-text data-a>
      <p class="ins__eyebrow">[ {d.eyebrow} ]</p>
      <h2 id="insight-title" class="ins__head" data-i-head>
        <span>{d.headline[0]}</span>{' '}<span class="ins__l2" data-i-h2>{d.headline[1]}</span>
      </h2>
    </div>

    <div class="ins__group" data-i-group data-a>
      <article class="ins__card" data-i-card aria-label="App view, simulated">
        <div class="ins__top">
          <p class="ins__chip">{c.label}</p>
          <p class="ins__sim">{c.simulated}</p>
        </div>
        <p class="ins__value" aria-label={c.sr}>
          <span>7</span><span class="ins__unit">h</span><span>12</span><span class="ins__unit">m</span>
        </p>
        <div class="ins__rhythm">
          <div class="ins__chart" aria-hidden="true">
            <img class="ins__area" src="/insight/chart-area.svg" alt="" width="368" height="79" />
            <img class="ins__line" src="/insight/chart-line.svg" alt="" width="370" height="59" />
            <img class="ins__halo ins__halo--1" src="/insight/awake-halo.svg" alt="" width="20" height="20" />
            <img class="ins__dot ins__dot--1" src="/insight/awake-dot.svg" alt="" width="11" height="11" />
            <img class="ins__halo ins__halo--2" src="/insight/awake-halo.svg" alt="" width="20" height="20" />
            <img class="ins__dot ins__dot--2" src="/insight/awake-dot.svg" alt="" width="11" height="11" />
          </div>
          <p class="ins__times"><span>{settled}</span><span>{up}</span></p>
        </div>
        <i class="ins__divider" aria-hidden="true"></i>
        <p class="ins__insight">{c.insight}</p>
      </article>
      <p class="ins__body" data-i-body>{d.body}</p>
    </div>
  </div>
</section>

<style>
  .scene--insight {
    color: var(--white);
  }
  .ins__glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* State 1: bottom left, 250 px above the bottom at 900 (State 2 moves it down to 50 px) */
  .ins__text {
    position: absolute;
    left: var(--margin);
    bottom: calc(100svh * 50 / 900);
    display: grid;
    gap: 18px;
    will-change: transform, opacity;
  }
  /* Mono/Medium, neutral/400 */
  .ins__eyebrow {
    font-family: var(--font-mono);
    font-weight: var(--w-label);
    font-size: var(--t-mono-md-size);
    line-height: var(--t-mono-md-lh);
    letter-spacing: var(--t-mono-md-ls);
    text-transform: uppercase;
    color: var(--neutral-400);
  }
  /* Heading/Heading 1; 520 px wide in State 1, 400 px in State 2 (set by insight.ts) */
  .ins__head {
    width: min(var(--hw, 520px), calc(100vw - 2 * var(--margin)));
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
    color: var(--white);
  }
  .ins__l2 {
    opacity: var(--o2, 0);
  }

  /* State 4 content: the card and the paragraph, centred in the space under the navbar */
  .ins__group {
    position: absolute;
    left: 50%;
    top: calc((100svh + 144px - 40px) / 2);
    width: min(432px, calc(100vw - 2 * var(--margin)));
    translate: -50% -50%;
    display: grid;
    gap: 28px;
    will-change: transform, opacity;
  }
  /* the glass card (Figma: white 14%, blur 30, line white 38%, radius 40, shadow 0 32 80 −16 black 28%) */
  .ins__card {
    display: grid;
    gap: 24px;
    padding: 32px;
    border-radius: 40px;
    border: 1px solid color-mix(in srgb, var(--white) 38%, transparent);
    background: color-mix(in srgb, var(--white) 14%, transparent);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    box-shadow: 0 32px 80px -16px color-mix(in srgb, var(--neutral-950) 28%, transparent);
    pointer-events: auto;
    user-select: text;
  }
  .ins__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  /* Mono/Medium in an ochre outline. On the glass the label reads in ochre-400 (Ochre itself is too
     low on this ground; same rule as the Cocoa card, D-135) */
  .ins__chip {
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--ochre) 50%, transparent);
    font-family: var(--font-mono);
    font-weight: var(--w-label);
    font-size: var(--t-mono-md-size);
    line-height: var(--t-mono-md-lh);
    letter-spacing: var(--t-mono-md-ls);
    text-transform: uppercase;
    color: var(--ochre-on-cocoa);
    white-space: nowrap;
  }
  /* Mono/X-Small, white 50% */
  .ins__sim {
    font-family: var(--font-mono);
    font-weight: var(--w-mono);
    font-size: var(--t-mono-xs-size);
    line-height: var(--t-mono-xs-lh);
    letter-spacing: var(--t-mono-xs-ls);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--white) 50%, transparent);
    white-space: nowrap;
  }
  /* Display/Display 4 with Heading/Heading 2 units at 60% */
  .ins__value {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: var(--w-display);
    font-size: var(--t-display-4-size);
    line-height: var(--t-display-4-lh);
    letter-spacing: var(--t-display-4-ls);
    font-variant-numeric: tabular-nums;
  }
  .ins__unit {
    font-size: var(--t-heading-2-size);
    line-height: var(--t-heading-2-lh);
    letter-spacing: var(--t-heading-2-ls);
    opacity: 0.6;
  }
  .ins__rhythm {
    display: grid;
    gap: 12px;
  }
  /* the night line chart: 368 × 96 in Figma, positions kept in %, so it stretches on phones */
  .ins__chart {
    position: relative;
    height: 96px;
  }
  .ins__chart img {
    position: absolute;
    display: block;
    max-width: none;
  }
  .ins__area {
    left: 0;
    top: 18.07%;
    width: 100%;
    height: 81.92%;
  }
  .ins__line {
    left: -0.27%;
    top: 17.03%;
    width: 100.54%;
    height: 61.72%;
  }
  .ins__halo {
    width: 20px;
    height: 20px;
  }
  .ins__dot {
    width: 11px;
    height: 11px;
  }
  .ins__halo--1 {
    left: 36.41%;
    top: 43.54%;
  }
  .ins__dot--1 {
    left: 37.64%;
    top: 48.23%;
  }
  .ins__halo--2 {
    left: 71.2%;
    top: 51.46%;
  }
  .ins__dot--2 {
    left: 72.42%;
    top: 56.15%;
  }
  /* Mono/Small, white 60% */
  .ins__times {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-weight: var(--w-mono);
    font-size: var(--t-mono-sm-size);
    line-height: var(--t-mono-sm-lh);
    letter-spacing: var(--t-mono-sm-ls);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--white) 60%, transparent);
    font-variant-numeric: tabular-nums;
  }
  .ins__divider {
    display: block;
    height: 1px;
    background: color-mix(in srgb, var(--white) 14%, transparent);
  }
  /* Paragraph/Large, white 90% */
  .ins__insight {
    font-size: var(--t-para-lg-size);
    line-height: var(--t-para-lg-lh);
    letter-spacing: var(--t-para-lg-ls);
    color: color-mix(in srgb, var(--white) 90%, transparent);
  }
  /* Paragraph/Medium, white 72%, centred under the card */
  .ins__body {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    text-align: center;
    color: color-mix(in srgb, var(--white) 72%, transparent);
    will-change: opacity;
  }
  @media (max-width: 719px) {
    .ins__card {
      gap: 18px;
      padding: 24px;
      border-radius: 32px;
    }
    .ins__group {
      top: calc((100svh + var(--header-h) - 16px) / 2);
      gap: 18px;
    }
    .ins__body {
      font-size: var(--t-para-sm-size);
      line-height: var(--t-para-sm-lh);
    }
  }
</style>
