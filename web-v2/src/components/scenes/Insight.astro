---
/**
 * S05 Daily insight — 17:30 · Dusk (D-142; Figma Design S05 State 1–4 40004260:709 / :745 / :781 /
 * :827, card component "Card / Last night" 40004260:693).
 *  - Dusk ground = Night with a soft --cocoa-300 light from the lower left and a shade upper right
 *    (Stage .stage__dusk, painted by story.ts; D-139 colour instead of the Figma ochre)
 *  - State 1: 17:30 · DAILY INSIGHT + "Everything it noticed." bottom left, ring right-centre
 *  - State 2: the ring grows, the text moves down to the edge and dims, "One calm view." joins
 *  - State 3: the camera goes into the opening; the glass card starts to show (≈ 45%)
 *  - State 4: the glass card (432 px, columns 5–8) fully legible + one small paragraph under it
 * The card is real HTML (selectable): glass (backdrop blur), LAST NIGHT chip, SIMULATED DATA,
 * 7h 12m, the night line chart (Figma SVGs in public/insight), settled / up, divider, one sentence.
 * Motion: scripts/sections/insight.ts.
 */
import { insight as d } from '../../content/copy';
const c = d.card;
const [settled, up] = c.line.split(' · ');
---

<section class="scene scene--insight" data-scene="insight" aria-labelledby="insight-title">
  <div class="scene__back">
    <!-- the warm light behind the glass card, inside the ring's opening (Figma "Glass light"; D-139 colour) -->
    <canvas class="ins__glow" data-i-glow data-a aria-hidden="true"></canvas>
  </div>
  <div class="scene__front">
    <div class="ins__text" data-i-text data-a>
      <p class="ins__eyebrow">{d.eyebrow}</p>
      <h2 id="insight-title" class="ins__head" data-i-head aria-label={d.headline.join(' ')}>
        <span>{d.headline[0]}</span>{' '}
        {
          /* D-143: "One calm view." word by word (inline-block), always in the layout so the three lines
             never reflow; each word fades and rises a little in State 2 */
          d.headline[1].split(' ').map((w, i) => (
            <>
              {i > 0 && ' '}
              <span class="ins__w" data-i-w>
                {w}
              </span>
            </>
          ))
        }
      </h2>
    </div>

    <div class="ins__group" data-i-group data-a>
      <article class="ins__card" data-i-card aria-label="App view, simulated">
        <div class="ins__in" data-i-in>
        <div class="ins__top" data-i-st>
          <p class="ins__chip">{c.label}</p>
        </div>
        <p class="ins__value" aria-label={c.sr} data-i-st>
          <span>7</span><span class="ins__unit">h</span><span>12</span><span class="ins__unit">m</span>
        </p>
        <div class="ins__rhythm">
          <div class="ins__chart" aria-hidden="true">
            <img class="ins__area" data-i-area src="/insight/chart-area.svg" alt="" width="368" height="79" />
            <!-- the Figma line (chart-line.svg), inline so it can be drawn left → right (D-143) -->
            <svg class="ins__line" viewBox="0 0 370 59.247" preserveAspectRatio="none" aria-hidden="true">
              <path data-i-line pathLength="1" d="M1.00008 54.4469C3.67008 50.6469 11.6701 39.2469 17.0001 31.6469C22.3301 24.0469 27.6701 13.9169 33.0001 8.8469C38.3301 3.7769 43.6701 -0.023095 49.0001 1.24691C54.3301 2.5169 59.6701 12.0169 65.0001 16.4469C70.3301 20.8769 75.6701 26.5769 81.0001 27.8469C86.3301 29.1169 91.6701 27.8469 97.0001 24.0469C102.33 20.2469 107.67 6.94691 113 5.04691C118.33 3.14691 123.67 7.5769 129 12.6469C134.33 17.7169 139.67 29.7469 145 35.4469C150.33 41.1469 155.67 48.1169 161 46.8469C166.33 45.5769 171.67 32.9169 177 27.8469C182.33 22.7769 187.67 15.8169 193 16.4469C198.33 17.0769 203.67 27.8469 209 31.6469C214.33 35.4469 219.67 40.5169 225 39.2469C230.33 37.9769 235.67 25.3169 241 24.0469C246.33 22.7769 251.67 28.4769 257 31.6469C262.33 34.8169 267.67 42.4169 273 43.0469C278.33 43.6769 283.67 34.8169 289 35.4469C294.33 36.0769 299.67 44.3169 305 46.8469C310.33 49.3769 315.67 51.9169 321 50.6469C326.33 49.3769 331.67 39.8769 337 39.2469C342.33 38.6169 347.67 43.6769 353 46.8469C358.33 50.0169 366.33 56.3469 369 58.2469" />
            </svg>
            <img class="ins__halo ins__halo--1" data-i-halo src="/insight/awake-halo.svg" alt="" width="20" height="20" />
            <img class="ins__dot ins__dot--1" data-i-dot src="/insight/awake-dot.svg" alt="" width="11" height="11" />
            <img class="ins__halo ins__halo--2" data-i-halo src="/insight/awake-halo.svg" alt="" width="20" height="20" />
            <img class="ins__dot ins__dot--2" data-i-dot src="/insight/awake-dot.svg" alt="" width="11" height="11" />
          </div>
          <p class="ins__times" data-i-st><span>{settled}</span><span>{up}</span></p>
        </div>
        <i class="ins__divider" data-i-div aria-hidden="true"></i>
        <p class="ins__insight" data-i-st>{c.insight}</p>
        </div>
      </article>
      <p class="ins__body" data-i-body>{d.body}</p>
    </div>
  </div>
</section>

<style>
  .scene--insight {
    color: var(--white);
  }
  .ins__glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* State 1: bottom left, 250 px above the bottom at 900 (State 2 moves it down to 50 px) */
  .ins__text {
    position: absolute;
    left: var(--margin);
    bottom: var(--content-bottom);
    display: grid;
    gap: var(--space-4);
    will-change: transform, opacity;
  }
  /* Label/X-Small in capitals, neutral/400 (D-156) */
  .ins__eyebrow {
    font-weight: var(--w-label);
    font-size: var(--t-label-xs-size);
    line-height: var(--t-label-xs-lh);
    letter-spacing: var(--t-caps-ls);
    text-transform: uppercase;
    color: var(--neutral-400);
  }
  /* Heading/Heading 1 in a fixed box: 400 px at 56 px (7.15em), so the full line is always three lines
     "Everything it / noticed. One / calm view." at every width (D-143: no reflow while scrolling) */
  .ins__head {
    width: 7.15em;
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
    color: var(--white);
  }
  .ins__w {
    display: inline-block;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* State 4 content: the card and the paragraph, centred in the space under the navbar */
  .ins__group {
    position: absolute;
    left: 50%;
    top: calc((calc(100 * var(--svh)) + var(--content-top) - var(--content-bottom)) / 2);
    width: min(432px, calc(100vw - 2 * var(--margin)));
    translate: -50% -50%;
    display: grid;
    gap: 28px;
    will-change: transform, opacity;
  }
  /* the glass card (Figma: white 14%, blur 30, line white 38%, radius 40, shadow 0 32 80 −16 black 28%) */
  .ins__card {
    padding: 32px;
    border-radius: 40px;
    border: 1px solid color-mix(in srgb, var(--white) 38%, transparent);
    background: color-mix(in srgb, var(--white) 14%, transparent);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    box-shadow: 0 32px 80px -16px color-mix(in srgb, var(--neutral-950) 28%, transparent);
    pointer-events: auto;
    user-select: text;
  }
  /* the card's content (blurred while the card comes in, D-143; the glass blur stays on the card) */
  .ins__in {
    display: grid;
    gap: 24px;
  }
  .ins__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  /* Label/X-Small in capitals in a thin Paper 45 % outline (D-158); the label is Paper
     (D-156: no ochre text) */
  .ins__chip {
    padding: var(--space-1) var(--space-3);
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--paper) 45%, transparent); /* D-158: white, not ochre */
    font-weight: var(--w-label);
    font-size: var(--t-label-xs-size);
    line-height: var(--t-label-xs-lh);
    letter-spacing: var(--t-caps-ls);
    text-transform: uppercase;
    color: var(--paper);
    white-space: nowrap;
  }
  /* Display/Display 4 with Heading/Heading 2 units at 60% */
  .ins__value {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: var(--w-display);
    font-size: var(--t-display-4-size);
    line-height: var(--t-display-4-lh);
    letter-spacing: var(--t-display-4-ls);
    font-variant-numeric: tabular-nums;
  }
  .ins__unit {
    font-size: var(--t-heading-2-size);
    line-height: var(--t-heading-2-lh);
    letter-spacing: var(--t-heading-2-ls);
    opacity: 0.6;
  }
  .ins__rhythm {
    display: grid;
    gap: 12px;
  }
  /* the night line chart: 368 × 96 in Figma, positions kept in %, so it stretches on phones */
  .ins__chart {
    position: relative;
    height: 96px;
  }
  .ins__chart img {
    position: absolute;
    display: block;
    max-width: none;
  }
  .ins__area {
    left: 0;
    top: 18.07%;
    width: 100%;
    height: 81.92%;
  }
  .ins__line {
    position: absolute;
    left: -0.27%;
    top: 17.03%;
    width: 100.54%;
    height: 61.72%;
    overflow: visible;
  }
  .ins__line path {
    fill: none;
    stroke: color-mix(in srgb, var(--white) 92%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* drawn with a normalised dash (pathLength 1); no non-scaling-stroke, which breaks that dash */
    stroke-dasharray: 1 1;
    stroke-dashoffset: var(--draw, 0);
  }
  .ins__halo,
  .ins__dot {
    transform-origin: 50% 50%;
  }
  .ins__halo {
    width: 20px;
    height: 20px;
  }
  .ins__dot {
    width: 11px;
    height: 11px;
  }
  .ins__halo--1 {
    left: 36.41%;
    top: 43.54%;
  }
  .ins__dot--1 {
    left: 37.64%;
    top: 48.23%;
  }
  .ins__halo--2 {
    left: 71.2%;
    top: 51.46%;
  }
  .ins__dot--2 {
    left: 72.42%;
    top: 56.15%;
  }
  /* Label/X-Small, white 70% (D-156; 60% fell to 4.05:1 on the card with the new Cocoa light) */
  .ins__times {
    display: flex;
    justify-content: space-between;
    font-weight: var(--w-label);
    font-size: var(--t-label-xs-size);
    line-height: var(--t-label-xs-lh);
    letter-spacing: var(--t-caps-ls);
    text-transform: uppercase;
    color: var(--white-alpha-70);
    font-variant-numeric: tabular-nums;
  }
  .ins__divider {
    display: block;
    height: 1px;
    background: color-mix(in srgb, var(--white) 14%, transparent);
  }
  /* Paragraph/Large, white 90% */
  .ins__insight {
    font-size: var(--t-para-lg-size);
    line-height: var(--t-para-lg-lh);
    letter-spacing: var(--t-para-lg-ls);
    color: color-mix(in srgb, var(--white) 90%, transparent);
  }
  /* Paragraph/Medium, white 72%, centred under the card */
  .ins__body {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    text-align: center;
    color: color-mix(in srgb, var(--white) 72%, transparent);
    will-change: opacity;
  }
  @media (max-width: 719px) {
    .ins__card {
      padding: 24px;
      border-radius: 32px;
    }
    .ins__in {
      gap: var(--space-4);
    }
    .ins__group {
      top: calc((calc(100 * var(--svh)) + var(--header-h) - 16px) / 2);
      gap: var(--space-4);
    }
    .ins__body {
      font-size: var(--t-para-sm-size);
      line-height: var(--t-para-sm-lh);
    }
  }
</style>
