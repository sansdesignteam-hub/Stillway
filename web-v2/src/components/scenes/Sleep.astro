---
/**
 * S03 Sleep summary (D-090). References (Figma Moodboard Layout, sticky 40004118:83):
 *  - Ultrahuman rim light → state 1: the (silver, polished) ring large on Night, only its edge lit
 *    by one cold light; text side left, ring right.
 *  - Sensiq label + number → states 2–4: small caps mono label above one big number, raised units.
 *  - Ultrahuman big number → one number per scroll step in ONE slot; the previous one dims and
 *    shrinks upward instead of vanishing. Our colours: Paper; the active label goes Paper, the others Paper 65 % (D-156: no ochre text).
 *  - Avoly corner light (D-136) → after Night is in: one soft warm beam from the upper right corner,
 *    behind the ring (back layer), with the green sensor light on the ring (ring stage).
 * Motion: scripts/sections/sleep.ts.
 */
import { sleep } from '../../content/copy';
/** "7h 12m" → numbers + small raised units (Sensiq number tile ref); "23:10" stays whole */
const split = (v: string) => [...v.matchAll(/(\d[\d:]*×?)|([a-z]+)|(\s+)/g)].map((m) => ({ text: m[0], unit: !!m[2] }));
---

<section class="scene scene--sleep" data-scene="sleep" aria-labelledby="sleep-title">
  <div class="scene__back">
    <div class="sleep__light" data-s-light data-a aria-hidden="true"><canvas class="sleep__beam" data-s-beam></canvas></div>
  </div>
  <img class="ring-fallback sleep__fb" src="/ring-fallback/fb-s03-polished.webp" alt="" width="1024" height="1024" data-ring-fallback data-a loading="lazy" decoding="async" />
  <div class="scene__front">
    <div class="sleep__col">
      <!-- no kicker: the navbar clock already reads "23:10 · Last night" (D-090 r1) -->
      <h2 id="sleep-title" class="sleep__head" data-s-head data-a>{sleep.headline}</h2>
      <dl class="sleep__slot">
        {
          sleep.stats.map((s) => (
            <div class="stat" data-s-stat data-a>
              <dt class="stat__tag t-tag">{s.tag}</dt>
              <dd class="stat__value" aria-label={s.sr}>
                {split(s.value).map((t) => (t.unit ? <span class="stat__unit">{t.text}</span> : t.text))}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="sleep__foot">
        <p class="sleep__line" data-s-line data-a>{sleep.line}</p>
        <p class="t-caps sleep__sim" data-s-sim data-a>{sleep.simulated}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .scene--sleep {
    color: var(--paper);
    --stone: var(--stone-on-night);
  }
  /* D-136 corner light: a soft warm beam falling from the upper right corner toward the ring,
     blurred, behind the ring (scene back layer, never on top of it) */
  .sleep__light {
    position: absolute;
    inset: 0;
  }
  /* painted by scripts/glow.ts (dithered, no banding); shape per breakpoint in sleep.ts */
  .sleep__beam {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* text column left (Ultrahuman ref 1 composition): kicker, headline, one number slot, foot */
  .sleep__col {
    --n: clamp(5rem, 18vw, 17rem); /* active number: ~half the width (Ultrahuman ref), ≈2× before */
    position: absolute;
    left: var(--margin);
    top: 50%;
    translate: 0 -50%;
    width: 58vw;
    display: grid;
    gap: 20px;
  }
  .sleep__kicker {
    color: var(--stone);
  }
  /* Heading/Heading 2 (= S01 statement) */
  .sleep__head {
    font-weight: var(--w-heading);
    font-size: var(--t-heading-2-size);
    line-height: var(--t-heading-2-lh);
    letter-spacing: var(--t-heading-2-ls);
  }
  /* one slot: all three numbers share it; the active one is full size, older ones shrink upward */
  .sleep__slot {
    /* room above for the previous number, which shrinks upward when the next one arrives */
    margin: calc(var(--n) * 0.32) 0 0;
    display: grid;
    min-height: calc(var(--fs-number) * 1.6);
    align-items: end;
  }
  .stat {
    grid-area: 1 / 1;
    display: grid;
    gap: 6px;
    transform-origin: 0 100%;
    will-change: transform, opacity;
  }
  .stat__tag {
    color: var(--stone-on-night);
    transition: color 0.3s ease;
  }
  /* D-156: the active label in Paper (no ochre text) */
  .stat:global(.is-active) .stat__tag {
    color: var(--paper);
  }
  /* the big number matches no text style (≈ 18vw, between Display 1 and 2): size kept, reported */
  .stat__value {
    margin: 0;
    font-size: var(--n);
    white-space: nowrap;
    font-weight: var(--w-heading);
    letter-spacing: var(--track-tight);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .stat__unit {
    font-size: 0.34em;
    vertical-align: 1.45em;
    margin-left: 0.04em;
    letter-spacing: 0;
  }
  .sleep__foot {
    display: grid;
    gap: 6px;
    min-height: 3.2em;
  }
  /* Paragraph/Small */
  .sleep__line {
    font-size: var(--t-para-sm-size);
    line-height: var(--t-para-sm-lh);
    letter-spacing: var(--t-para-sm-ls);
  }
  .sleep__sim {
    color: var(--stone-on-night);
  }
  .sleep__fb {
    --rw: min(56vw, 82vh);
    left: 72%;
    width: calc(var(--rw) * 1.6);
    max-width: none;
    translate: -50% 0;
    top: calc(50% - var(--rw) * 1.6 * 0.4316);
  }
  @media (max-width: 719px) {
    .sleep__col {
      top: auto;
      bottom: 24px;
      translate: none;
      right: var(--margin);
      width: auto;
      gap: 12px;
    }
    .sleep__slot {
      margin-top: 52px;
    }
    .sleep__col {
      --n: 27vw;
    }
    .sleep__fb {
      --rw: 80vw;
      left: 50%;
      top: calc(28% - var(--rw) * 1.6 * 0.4316);
    }
  }
</style>
