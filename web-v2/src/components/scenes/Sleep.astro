---
/**
 * S03 Sleep summary (D-090). References (Figma Moodboard Layout, sticky 40004118:83):
 *  - Ultrahuman rim light → state 1: the (silver, polished) ring large on Night, only its edge lit
 *    by one cold light; text side left, ring right.
 *  - Sensiq label + number → states 2–4: small caps mono label above one big number, raised units.
 *  - Ultrahuman big number → one number per scroll step in ONE slot; the previous one dims and
 *    shrinks upward instead of vanishing. Our colours: Paper, ochre only on the active label.
 * Motion: scripts/sections/sleep.ts.
 */
import { sleep } from '../../content/copy';
/** "7h 12m" → numbers + small raised units (Sensiq number tile ref); "23:10" stays whole */
const split = (v: string) => [...v.matchAll(/(\d[\d:]*×?)|([a-z]+)|(\s+)/g)].map((m) => ({ text: m[0], unit: !!m[2] }));
---

<section class="scene scene--sleep" data-scene="sleep" aria-labelledby="sleep-title">
  <img class="ring-fallback sleep__fb" src="/ring-fallback/fb-s03-polished.webp" alt="" width="1024" height="1024" data-ring-fallback data-a loading="lazy" decoding="async" />
  <div class="scene__front">
    <div class="sleep__col">
      <p class="sleep__kicker t-mono" data-s-kicker data-a>{sleep.kicker}</p>
      <h2 id="sleep-title" class="sleep__head" data-s-head data-a>{sleep.headline}</h2>
      <dl class="sleep__slot">
        {
          sleep.stats.map((s) => (
            <div class="stat" data-s-stat data-a>
              <dt class="stat__tag t-tag">{s.tag}</dt>
              <dd class="stat__value" aria-label={s.sr}>
                {split(s.value).map((t) => (t.unit ? <span class="stat__unit">{t.text}</span> : t.text))}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="sleep__foot">
        <p class="sleep__line" data-s-line data-a>{sleep.line}</p>
        <p class="t-mono sleep__sim" data-s-sim data-a>{sleep.simulated}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .scene--sleep {
    color: var(--paper);
    --stone: var(--stone-on-night);
  }
  /* text column left (Ultrahuman ref 1 composition): kicker, headline, one number slot, foot */
  .sleep__col {
    position: absolute;
    left: var(--margin);
    top: 50%;
    translate: 0 -50%;
    width: min(34rem, 40vw);
    display: grid;
    gap: 20px;
  }
  .sleep__kicker {
    color: var(--stone);
  }
  .sleep__head {
    font-size: var(--fs-h3);
    font-weight: var(--w-heading);
    letter-spacing: var(--track-tight);
    line-height: 1.15;
  }
  /* one slot: all three numbers share it; the active one is full size, older ones shrink upward */
  .sleep__slot {
    /* room above for the previous number, which shrinks upward when the next one arrives */
    margin: calc(var(--fs-number) * 0.85) 0 0;
    display: grid;
    min-height: calc(var(--fs-number) * 1.6);
    align-items: end;
  }
  .stat {
    grid-area: 1 / 1;
    display: grid;
    gap: 6px;
    transform-origin: 0 100%;
    will-change: transform, opacity;
  }
  .stat__tag {
    color: var(--stone);
    transition: color 0.3s ease;
  }
  .stat:global(.is-active) .stat__tag {
    color: var(--ochre);
  }
  .stat__value {
    margin: 0;
    font-size: calc(var(--fs-number) * 1.3);
    font-weight: var(--w-heading);
    letter-spacing: var(--track-tight);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .stat__unit {
    font-size: 0.34em;
    vertical-align: 1.45em;
    margin-left: 0.04em;
    letter-spacing: 0;
  }
  .sleep__foot {
    display: grid;
    gap: 6px;
    min-height: 3.2em;
  }
  .sleep__line {
    font-size: var(--fs-small);
  }
  .sleep__sim {
    color: var(--stone);
  }
  .sleep__fb {
    --rw: min(56vw, 82vh);
    left: 72%;
    width: calc(var(--rw) * 1.6);
    max-width: none;
    translate: -50% 0;
    top: calc(50% - var(--rw) * 1.6 * 0.4316);
  }
  @media (max-width: 719px) {
    .sleep__col {
      top: auto;
      bottom: 24px;
      translate: none;
      right: var(--margin);
      width: auto;
      gap: 12px;
    }
    .sleep__slot {
      margin-top: 52px;
    }
    .stat__value {
      font-size: 4.25rem;
    }
    .sleep__fb {
      --rw: 80vw;
      left: 50%;
      top: calc(28% - var(--rw) * 1.6 * 0.4316);
    }
  }
</style>
