---
/**
 * S04 Activity & rest — Day arc (D-138, Figma Design 40004245:50: 04 State 1–5 40004410:3751 …:3847,
 * 03→04 Lensa 40004471:5860 …:6529).
 *  - the 03 → 04 "lens": the 07:40 photo shows inside the ring's opening, the ring opens past the
 *    screen and the photo becomes the active card at the top of the arc (scripts/sections/activity.ts)
 *  - Day arc: the active card (264 × 352) at the top of a circle (centre 720 / 1758, R 1340 in the
 *    1440 × 900 frame), the others along it every 12°, dimmer with distance (past dimmer than future);
 *    big time + status under the active card; scroll turns the arc to the left, one photo per state
 *  - Night with a soft --cocoa-300 light lower left (Figma "Ember glow" place, colour D-139) and a
 *    night shade (upper right), painted with dither (scripts/glow.ts)
 * Photos: the 5 C-02 frames from V1, read from ../design (not copied, not retouched — D-073).
 */
import Img from '../Img.astro';
import { activity as d } from '../../content/copy';
import s0740 from '../../../../design/assets/v1/home/S3p-0740-moving-walk.png';
import s0900 from '../../../../design/assets/v1/home/S3p-0900-resting-focus.png';
import s1030 from '../../../../design/assets/v1/home/S3p-1030-moving-stretch.png';
import s1230 from '../../../../design/assets/v1/home/S3p-1230-resting-lunch.png';
import s1530 from '../../../../design/assets/v1/home/S3p-1530-moving-stairs.png';

const srcs = { s0740, s0900, s1030, s1230, s1530 } as const;
const first = d.frames[0];
const digits = Array.from({ length: 20 }, (_, i) => i % 10); // 0–9 twice: a digit always rolls forward
---

<section class="scene scene--activity" data-scene="activity" aria-labelledby="activity-title">
  <div class="scene__back">
    <canvas class="act__glow" data-a-glow data-a aria-hidden="true"></canvas>
    <canvas class="act__dawn" data-a-dawn data-a aria-hidden="true"></canvas>
    <div class="act__arc" aria-hidden="true">
      <i class="act__orbit" data-a-orbit data-a></i>
      {
        d.frames.map((f) => (
          <div class="act__card" data-a-card data-a data-time={f.time}>
            <Img src={srcs[f.key as keyof typeof srcs]} alt="" sizes="(max-width: 719px) 270px, 400px" widths={[540, 800, 1060]} ready />
          </div>
        ))
      }
      {
        d.frames.map((f) => (
          <span class="act__label" data-a-label data-a>
            {f.time}
          </span>
        ))
      }
    </div>
  </div>
  <div class="scene__front">
    <div class="act__intro" data-a-intro data-a>
      <h2 id="activity-title" class="act__title">
        <span class="act__t1">{d.heading[0]}</span>
        <span>{d.heading[1]}</span>
      </h2>
      <p class="act__body">{d.body}</p>
    </div>

    <div class="act__now" data-a-now data-a aria-hidden="true">
      <p class="act__time">
        {
          first.time.split('').map((c) =>
            c === ':' ? (
              <span class="act__colon">:</span>
            ) : (
              <span class="dg">
                <span class="dg__s" data-a-dg>
                  {digits.map((n) => (
                    <span>{n}</span>
                  ))}
                </span>
              </span>
            ),
          )
        }
      </p>
      <p class="act__status">
        <i class="act__dot"></i>
        <span class="act__lines">
          {
            d.frames.map((f) => (
              <span class="act__line" data-a-sline>
                {f.state} · {f.detail}
              </span>
            ))
          }
        </span>
      </p>
    </div>

    <ol class="sr-only">
      {
        d.frames.map((f) => (
          <li>
            {f.time}, {f.state}, {f.detail} (simulated). {f.alt}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .scene--activity {
    color: var(--paper);
    /* active card size, set by activity.ts from the viewport (264 × 352 at 1440 × 900) */
    --cw: 264px;
    --ch: 352px;
  }
  .act__glow,
  .act__dawn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .act__arc {
    position: absolute;
    inset: 0;
  }
  /* the orbit: Figma "Orbit", white 14%, 1 px */
  .act__orbit {
    position: absolute;
    left: 0;
    top: 0;
    border: 1px solid color-mix(in srgb, var(--white) 14%, transparent);
    border-radius: 50%;
    will-change: transform;
  }
  .act__card {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--cw);
    height: var(--ch);
    overflow: hidden;
    border-radius: 12px;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }
  /* the active card carries a white 50% line (Figma stroke-white), drawn over the photo */
  .act__card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--white) calc(var(--b, 0) * 50%), transparent);
    pointer-events: none;
  }
  .act__card :global(picture),
  .act__card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .act__card :global(img) {
    object-fit: cover;
  }
  /* Mono/Small, under each waiting card along its radius */
  .act__label {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: var(--w-label);
    font-size: var(--t-label-xs-size);
    line-height: var(--t-label-xs-lh);
    letter-spacing: var(--t-caps-ls);
    font-variant-numeric: tabular-nums;
    color: var(--white);
    white-space: nowrap;
    will-change: transform, opacity;
  }
  .act__intro {
    position: absolute;
    left: var(--margin);
    top: calc(var(--header-h) + 68px);
    width: min(416px, calc(100vw - 2 * var(--margin)));
    display: grid;
    gap: 18px;
  }
  /* Heading/Heading 1: "Activity" neutral/400, "and rest." Paper */
  .act__title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.21em;
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
    color: var(--paper);
  }
  /* D-158: "Activity" white like "and rest." (replaces the grey of D-141) */
  .act__t1 {
    color: inherit;
  }
  /* Paragraph/Medium, white 78% */
  .act__body {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    color: color-mix(in srgb, var(--white) 78%, transparent);
  }
  .act__now {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    justify-items: center;
    gap: 6px;
    will-change: transform, opacity;
  }
  /* Display/Display 4; each digit rolls on its own strip (line height = size for Display 4) */
  .act__time {
    display: flex;
    font-weight: var(--w-display);
    font-size: var(--t-display-4-size);
    line-height: var(--t-display-4-lh);
    letter-spacing: var(--t-display-4-ls);
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }
  .dg {
    display: block;
    height: var(--t-display-4-lh);
    overflow: hidden;
  }
  .dg__s {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }
  .dg__s > span {
    display: block;
    height: var(--t-display-4-lh);
  }
  /* Label/Large; the status lines change with an upward move */
  .act__status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: var(--w-label);
    font-size: var(--t-label-lg-size);
    line-height: var(--t-label-lg-lh);
    letter-spacing: var(--t-label-lg-ls);
    color: var(--white);
  }
  .act__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--white);
  }
  .act__lines {
    display: grid;
    height: var(--t-label-lg-lh);
    overflow: hidden;
  }
  .act__line {
    grid-area: 1 / 1;
    white-space: nowrap;
    will-change: transform, opacity;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 719px) {
    .act__intro {
      top: calc(var(--header-h) + 16px);
      gap: 8px;
    }
    .act__body {
      display: none;
    }
  }
</style>
