---
/**
 * S04 Activity & rest (D-090). References: the three Oryzo "So portable, it's wearable" frames
 * (Figma sticky 40004118:92):
 *  - ref 1 → state 1: small caps line + bigger line top-left, short paragraph; one large portrait
 *    in a dashed frame in the centre, the others small beside it; scroll hint bottom centre.
 *  - ref 2 → states 2–4: the strip moves left, the next photo takes the frame; big time + status
 *    bottom-left, time list bottom-right.
 *  - ref 3 → state 5: the others have left, the frame lines fade, one photo stays and darkens.
 * Photos: the 5 C-02 frames from V1, read from ../design (not copied, not retouched — D-073).
 * Motion: scripts/sections/activity.ts.
 */
import Img from '../Img.astro';
import { activity as d, hero } from '../../content/copy';
import s0740 from '../../../../design/assets/v1/home/S3p-0740-moving-walk.png';
import s0900 from '../../../../design/assets/v1/home/S3p-0900-resting-focus.png';
import s1030 from '../../../../design/assets/v1/home/S3p-1030-moving-stretch.png';
import s1230 from '../../../../design/assets/v1/home/S3p-1230-resting-lunch.png';
import s1530 from '../../../../design/assets/v1/home/S3p-1530-moving-stairs.png';

const srcs = { s0740, s0900, s1030, s1230, s1530 } as const;
const first = d.frames[0];
---

<section class="scene scene--activity" data-scene="activity" aria-labelledby="activity-title" data-active="0">
  <div class="scene__back">
    <div class="act__glow" data-a-glow data-a></div>
  </div>
  <div class="scene__front">
    <div class="act__head" data-a-head data-a>
      <h2 id="activity-title" class="act__title" aria-label={d.heading.join(' ')}>
        <span class="act__caps" aria-hidden="true">{d.heading[0]}</span>
        <span class="act__line" aria-hidden="true">{d.heading[1]}</span>
      </h2>
      <p class="act__body">{d.body}</p>
    </div>

    <div class="act__strip">
      <div class="act__frame" data-a-frame data-a aria-hidden="true"></div>
      <ol class="act__items">
        {
          d.frames.map((f) => (
            <li class="act__item" data-a-item data-a data-time={f.time} data-state={f.state} data-detail={f.detail}>
              <Img src={srcs[f.key as keyof typeof srcs]} alt={f.alt} sizes="(max-width: 719px) 58vw, 34vh" widths={[480, 768, 1060]} loading="eager" />
              <span class="sr-only">
                {f.time}, {f.state}, {f.detail} (simulated).
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="act__now" data-a-now data-a aria-hidden="true">
      <p class="act__time" data-a-time>{first.time}</p>
      <p class="act__status">
        <i class="act__key" data-a-key data-state={first.state.toLowerCase()}></i>
        <span data-a-state>{first.state}</span>
        <span class="act__sep">·</span>
        <span data-a-detail>{first.detail}</span>
      </p>
      <p class="t-mono act__sim">{d.simulated}</p>
    </div>

    <ol class="act__list t-mono" data-a-list data-a aria-hidden="true">
      {d.frames.map((f, i) => <li data-a-tick class:list={[i === 0 && 'is-active']}>{f.time}</li>)}
    </ol>
    <p class="act__hint t-label" data-a-hint data-a aria-hidden="true">{hero.scroll}</p>
  </div>
</section>

<style>
  .scene--activity {
    color: var(--paper);
    --stone: var(--stone-on-night);
    --a: min(calc(70vh * 0.714), 34vw); /* active portrait width (1060 × 1484), ~70vh tall */
  }
  /* Oryzo's warm dark ground: Night with one low ochre glow from the lower left */
  .act__glow {
    position: absolute;
    left: -20vw;
    bottom: -40vh;
    width: 80vw;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(183 111 32 / 0.28), rgb(183 111 32 / 0));
    filter: blur(40px);
  }
  .act__head {
    position: absolute;
    left: var(--margin);
    top: calc(var(--header-h) + 56px); /* clear of the small photos beside the frame (ref 2) */
    width: min(26rem, 24vw);
    display: grid;
    gap: 16px;
  }
  /* Oryzo "SO PORTABLE, / it's wearable": line 1 small dim caps, line 2 big, bright and heavier */
  .act__title {
    display: grid;
    gap: 4px;
    line-height: 1.05;
  }
  .act__caps {
    font-size: clamp(15px, 1.25vw, 19px);
    font-weight: var(--w-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--stone);
  }
  .act__line {
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--w-display);
    letter-spacing: var(--track-tight);
    color: var(--paper);
  }
  .act__body {
    font-size: var(--fs-small);
    color: var(--stone);
  }
  .act__strip {
    position: absolute;
    left: 50%;
    top: 47%;
    width: var(--a);
    aspect-ratio: 1060 / 1484;
    translate: -50% -50%;
  }
  .act__frame {
    position: absolute;
    inset: -10px;
    border: 1px dashed rgb(247 245 240 / 0.55);
  }
  .act__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .act__item {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    overflow: hidden;
    --dark: 0;
  }
  .act__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .act__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--night);
    opacity: calc(var(--dark) * 0.75);
  }
  .act__now {
    position: absolute;
    left: var(--margin);
    bottom: clamp(28px, 7vh, 64px);
    display: grid;
    gap: 8px;
  }
  .act__time {
    font-size: var(--fs-number);
    font-weight: var(--w-heading);
    letter-spacing: var(--track-tight);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .act__status {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: var(--fs-body);
  }
  .act__sep {
    color: var(--stone);
  }
  .act__key {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--paper);
  }
  .act__key[data-state='moving'] {
    background: var(--paper);
  }
  .act__sim {
    color: var(--stone);
  }
  .act__list {
    position: absolute;
    right: var(--margin);
    bottom: clamp(28px, 7vh, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    text-align: right;
  }
  .act__list li {
    color: var(--stone);
    opacity: 0.6;
    transition: color 0.3s ease, opacity 0.3s ease;
  }
  .act__list li:global(.is-active) {
    color: var(--paper);
    opacity: 1;
  }
  .act__hint {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    color: var(--stone);
  }
  @media (max-width: 719px) {
    .scene--activity {
      --a: 58vw;
    }
    .act__head {
      top: calc(var(--header-h) + 8px);
      right: var(--margin);
      width: auto;
      gap: 6px;
    }
    .act__body {
      font-size: 0.8125rem;
    }
    .act__strip {
      top: 50%;
    }
    .act__list,
    .act__hint {
      display: none;
    }
    .act__now {
      bottom: 20px;
      gap: 4px;
    }
    .act__time {
      font-size: 3rem;
    }
    .act__status {
      font-size: 0.9375rem;
    }
  }
</style>
