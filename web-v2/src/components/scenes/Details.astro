---
/**
 * S06 Product details — 21:00 · Paper (D-144; Figma Design 06 State 1–4 40004263:662 / :710 / :752 /
 * :794 and 06 · Tangan & ring A–C 40004325:3298 / :3333 / :3368).
 *  - States 1–3: the ring stands upright, opening to the camera, and rolls left → right on a light
 *    pine table whose right edge is the middle of the screen, turning by the distance, two faint
 *    motion ghosts behind it. Headline, then the two steps, top left; a 4-step progress bar.
 *  - At the edge it tips over and falls (oryzo.ai): turning as it drops, slowing near the finger.
 *  - Hand A–C: the hand photo A-1 (no ring, D-133) rises from below the screen — its cut bottom is
 *    always below the viewport and melted into Paper — the ring slides onto the finger to the seat
 *    (s06-pose.json), [ SILVER ] beside it, "Then, it just fits." centred on top.
 * The table is the 3D Designer's pine table GLB in the ring stage (D-146, stage.ts); the CSS table here
 * stands in until it has loaded and without WebGL.
 * Motion: scripts/sections/details.ts.
 */
import Img from '../Img.astro';
import { details as d } from '../../content/copy';
import hand from '../../../../design/assets/v2/A-1-hand-left-alpha.png';
import ringed from '../../../../design/assets/v2/A-1b-hand-with-ring.png';
---

<section class="scene scene--details" data-scene="details" aria-labelledby="details-title">
  <div class="scene__back">
    <!-- Figma "Meja kayu (tepi di x=720)": top face from y 600, right edge at the middle -->
    <div class="det__table" data-d-table data-a aria-hidden="true">
      <i class="det__wall"></i>
      <i class="det__wood"></i>
      <i class="det__back"></i>
      <i class="det__hi"></i>
      <i class="det__side"></i>
      <i class="det__drop"></i>
      <i class="det__shadow" data-d-shadow></i>
    </div>
    <div class="det__card" data-d-card data-a>
      <div class="det__hand" data-d-hand>
        <Img src={hand} alt={d.alt.hand} sizes="(max-width: 719px) 60vw, 40vw" widths={[400, 579]} ready fallbackFormat="png" class="det__img" />
        <i class="det__seat" data-d-seat aria-hidden="true"></i>
        <div class="det__ringed" data-d-ringed aria-hidden="true">
          <Img src={ringed} alt="" sizes="(max-width: 719px) 120vw, 90vw" widths={[800, 1254]} ready class="det__img" />
        </div>
      </div>
    </div>
  </div>

  <img class="ring-fallback det__fb" src="/ring-fallback/fb-s02-polished.webp" alt="" width="1024" height="1024" data-ring-fallback data-fb-range="0,2" data-a loading="lazy" decoding="async" />

  <div class="scene__front">
    <p class="sr-only">{d.alt.ring}</p>
    <h2 id="details-title" class="det__head" data-d-head data-a>{d.headline}</h2>
    {
      d.steps.map((s, i) => (
        <div class="det__step" data-d-step={i} data-a>
          <h3 class="det__stitle">{s.title}</h3>
          <p class="det__body">{s.body}</p>
        </div>
      ))
    }
    <div class="det__fits" data-d-fits data-a>
      <h3 class="det__fhead">{d.fits.title}</h3>
      <p class="det__fbody">{d.fits.body}</p>
    </div>
    <p class="det__label" data-d-label data-a>{d.label}</p>
    <div class="det__progress" data-d-progress data-a aria-hidden="true">
      {[0, 1, 2, 3].map(() => <i data-d-tick></i>)}
    </div>
  </div>
</section>

<style>
  .scene--details {
    color: var(--ink);
    /* set by details.ts from the viewport */
    --hx: 60vw;
    --hy: 50vh;
    --hs: 0.8;
    --ty: 66.7lvh; /* table top (Figma y 600 of 900) */
    --tx: 50vw; /* table right edge (Figma x 720) */
  }
  /* temporary table: a light pine top seen from above, a lit right edge with a darker side and its
     shadow, a soft wall shadow on the back edge (Figma layers, colours as tokens) */
  /* D-146: once the pine table GLB is in the ring stage (html.table-ready), this CSS table is only the
     stand-in for no WebGL / reduced motion */
  :global(html.table-ready) .det__table {
    display: none;
  }
  .det__table {
    position: absolute;
    left: 0;
    top: calc(var(--ty) - 30px);
    width: calc(var(--tx) + 30px);
    bottom: -2px;
  }
  .det__table i {
    position: absolute;
  }
  .det__wall {
    left: 0;
    top: 0;
    width: var(--tx);
    height: 30px;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--ink) 6%, transparent));
  }
  .det__wood {
    left: 0;
    top: 30px;
    width: var(--tx);
    bottom: 0;
    background:
      repeating-linear-gradient(
        180deg,
        color-mix(in srgb, var(--wood-grain) 0%, transparent) 0px,
        color-mix(in srgb, var(--wood-grain) 18%, transparent) 2px,
        color-mix(in srgb, var(--wood-grain) 0%, transparent) 5px,
        color-mix(in srgb, var(--wood-grain) 0%, transparent) 11px,
        color-mix(in srgb, var(--wood-grain) 10%, transparent) 13px,
        color-mix(in srgb, var(--wood-grain) 0%, transparent) 17px
      ),
      linear-gradient(to bottom, var(--wood-top-far), var(--wood-top));
  }
  .det__back {
    left: 0;
    top: 30px;
    width: var(--tx);
    height: 1px;
    background: color-mix(in srgb, var(--wood-side) 35%, transparent);
  }
  .det__hi {
    left: calc(var(--tx) - 2px);
    top: 30px;
    width: 2px;
    bottom: 0;
    background: color-mix(in srgb, var(--white) 70%, transparent);
  }
  .det__side {
    left: var(--tx);
    top: 30px;
    width: 6px;
    bottom: 0;
    background: var(--wood-side);
  }
  .det__drop {
    left: calc(var(--tx) + 6px);
    top: 30px;
    width: 30px;
    bottom: 0;
    background: linear-gradient(to right, color-mix(in srgb, var(--ink) 14%, transparent), transparent);
  }
  /* Figma "Contact shadow": Ink 35% → 12% → 0 under the ring, follows it (details.ts) */
  .det__shadow {
    left: 0;
    top: 0;
    width: 300px;
    height: 30px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--ink) 35%, transparent),
      color-mix(in srgb, var(--ink) 12%, transparent) 50%,
      transparent 100%
    );
    will-change: transform, opacity;
  }
  /* the hand layer; 06 → 07 scrolls it up with the page (D-147: no card) */
  .det__card {
    position: absolute;
    inset: 0;
  }
  /* A-1 (579 × 1198). Its bottom (the cut at the wrist) is always placed below the viewport by
     details.ts; on top of that its lowest 14% melts into Paper, so no cut can ever show */
  .det__hand {
    position: absolute;
    left: var(--hx);
    top: var(--hy);
    width: calc(579px * var(--hs));
    height: calc(1198px * var(--hs));
    -webkit-mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
    will-change: transform;
  }
  .det__hand :global(picture),
  .det__hand :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* A-1b (same hand with the ring, crop offset 50, 56): only the ring area, no WebGL / reduced */
  .det__ringed {
    position: absolute;
    left: calc(-50px * var(--hs));
    top: calc(-56px * var(--hs));
    width: calc(1254px * var(--hs));
    height: calc(1254px * var(--hs));
    opacity: 0;
    -webkit-mask-image: radial-gradient(ellipse 8% 5.2% at 31.3% 33.1%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 8% 5.2% at 31.3% 33.1%, #000 62%, transparent 100%);
  }
  /* contact shadow of the 3D ring on the finger, just under the band */
  .det__seat {
    position: absolute;
    left: calc((343px - 62px) * var(--hs));
    top: calc((360px + 22px) * var(--hs));
    width: calc(124px * var(--hs));
    height: calc(26px * var(--hs));
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--cocoa) 42%, transparent), color-mix(in srgb, var(--cocoa) 16%, transparent) 60%, transparent 100%);
    filter: blur(calc(3px * var(--hs)));
    opacity: 0;
  }
  /* reduced motion / no WebGL: a polished still on the table (states 1–3) */
  .det__fb {
    left: var(--fbx);
    top: var(--fby);
    width: var(--fbw);
    translate: none;
  }
  /* Heading/Heading 1, top left (Figma Content pt 144, 400 / 380 px boxes) */
  .det__head,
  .det__step {
    position: absolute;
    left: var(--margin);
    top: calc(var(--header-h) + 68px);
  }
  .det__head,
  .det__stitle {
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
  }
  .det__head {
    width: min(7.15em, calc(100vw - 2 * var(--margin)));
  }
  /* Figma 380 px; Geist runs a little wider here, 440 keeps each step title on one line */
  .det__step {
    width: min(440px, calc(100vw - 2 * var(--margin)));
    display: grid;
    gap: 20px;
  }
  /* Paragraph/Medium, Stone */
  .det__body,
  .det__fbody {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    color: var(--stone);
  }
  /* "Then, it just fits." centred on top (Figma Content pt 120, gap 20) */
  .det__fits {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: calc(var(--header-h) + 44px);
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }
  .det__fhead {
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
  }
  .det__fbody {
    max-width: 520px;
  }
  /* [ SILVER ]: Mono/Small, Ink, beside the ring (Figma +217 / −12 from the seat) */
  .det__label {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-weight: var(--w-mono);
    font-size: var(--t-mono-sm-size);
    line-height: var(--t-mono-sm-lh);
    letter-spacing: var(--t-mono-sm-ls);
    color: var(--ink);
    white-space: nowrap;
  }
  /* 4-step progress, bottom left (Figma: active 32 px Ink, others 12 px line) */
  .det__progress {
    position: absolute;
    left: var(--margin);
    bottom: 57px;
    display: flex;
    gap: 8px;
  }
  .det__progress i {
    display: block;
    height: 3px;
    width: 12px;
    border-radius: 2px;
    background: var(--line);
    transition: width 0.4s var(--ease-out), background-color 0.4s;
  }
  .det__progress i.is-on {
    width: 32px;
    background: var(--ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 719px) {
    .det__head,
    .det__step {
      top: calc(var(--header-h) + 16px);
      right: var(--margin);
    }
    .det__step {
      gap: 10px;
    }
    .det__fits {
      top: calc(var(--header-h) + 16px);
      gap: 10px;
    }
    .det__progress {
      bottom: 24px;
    }
  }
</style>
