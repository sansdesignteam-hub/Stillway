---
/**
 * S07 Specs & benefits — 21:00 · Sand → the everyday photo (D-149: Figma Design 07 State 1–7,
 * 40004263:834 / :870 / :923 / :979, 40004330:3439 / :3441, 40004263:1042, with the user's notes).
 *  - State 1: "Through the day." (Display 2) in the middle.
 *  - State 2: the words part ('Through' left, 'the day.' right, cut at the cards' edges); four
 *    photo cards rise from below into a row between them.
 *  - States 3–6, (I) Night … (IV) Rinse: the cards close into a stack in the middle, a full-width
 *    hairline behind it; title above the line and the sentence below it on the left, a counter above
 *    and the spec + small note below on the right. Each step the front card rises behind the stack
 *    and the next one comes forward; titles rise letter by letter from behind the line, the lines
 *    below rise line by line (masks), the counter circle fills. No orbit lines (D-149 note 1).
 *  - End (obsidianassembly.com "The Connection"): the Rinse card moves down and shrinks while the
 *    big photo (inset frame, radius 14) comes up from below at scroll speed, its content slower
 *    (parallax). D-150: the photo is the package flat lay (A-11), bright, with only a soft text
 *    shadow on the words; the group is centred in the frame. D-151: layers photo → card → words
 *    → caption, the words run whole over the card (obsidianassembly.com "The Connection"). "The" small over "Everyday" (Display 1), both
 *    white, "The" flush with the E; caption free under the right end of "Everyday", below the "y" (s07-ref-everyday-layout).
 * Motion: scripts/sections/specs.ts.
 */
import Img from '../Img.astro';
import { specs as d } from '../../content/copy';
import night from '../../../../design/assets/v2/A-2-card-night.png';
import desk from '../../../../design/assets/v2/A-2-card-desk.png';
import move from '../../../../design/assets/v2/A-2-card-move.png';
import rinse from '../../../../design/assets/v2/A-2-card-rinse.png';
import everyday from '../../../../design/assets/v1/home/A-11-package-flatlay.png'; // D-150

const img: Record<string, any> = { night, desk, move, rinse };
// Figma: the Desk note wraps in a 217 px box, the others sit in 316
const noteW: Record<string, number> = { desk: 217 };
---

<section class="scene scene--specs" data-scene="specs" aria-labelledby="specs-title">
  <!-- the everyday photo sits on the back layer, so the S08 ring can show over it (D-096) -->
  <div class="scene__back">
    <div class="sp__every" data-s-every data-a>
      <div class="sp__par" data-s-par>
        <Img src={everyday} alt={d.everyday.alt} sizes="100vw" widths={[960, 1448]} ready class="sp__everyimg" />
      </div>
      <i class="sp__evshade" aria-hidden="true"></i>
      <i class="sp__dark" data-s-dark></i>
    </div>
  </div>

  <div class="scene__front">
    <h2 id="specs-title" class="sp__words" aria-label={d.headline.join(' ')}>
      <span class="sp__w" data-s-w="0" data-a aria-hidden="true">{d.headline[0]}</span>
      <span class="sp__w" data-s-w="1" data-a aria-hidden="true">{d.headline[1]}</span>
    </h2>

    <i class="sp__line" data-s-line data-a aria-hidden="true"></i>

    {
      d.cards.map((c, i) => (
        <figure class="sp__card" data-s-card={i} data-a>
          <Img src={img[c.key]} alt={c.alt} sizes="(max-width: 719px) 60vw, 28vw" widths={[480, 800, 1122]} ready class="sp__cardimg" />
        </figure>
      ))
    }

    {
      d.cards.map((c, i) => (
        <div class="sp__text" data-s-text={i} data-a>
          <h3 class="sp__name" aria-label={`(${c.n}) ${c.name}`}>
            <span class="sp__nmask" aria-hidden="true">
              {`(${c.n}) ${c.name}`.split('').map((ch) => (
                <span class="sp__ch" data-s-ch>
                  {ch}
                </span>
              ))}
            </span>
          </h3>
          <div class="sp__below">
            <p class="sp__ttl" data-s-lines>
              {c.title}
            </p>
            <div class="sp__right" style={`--nw:${noteW[c.key] ?? 316}px`}>
              <p class="sp__spec" data-s-lines>
                {c.spec}
              </p>
              {c.note && (
                <p class="sp__note" data-s-lines>
                  {c.note}
                </p>
              )}
            </div>
          </div>
        </div>
      ))
    }

    <div class="sp__count" data-s-count data-a aria-hidden="true">
      <svg viewBox="0 0 76 76"><circle cx="38" cy="38" r="37.5"></circle><circle class="sp__arc" data-s-arc cx="38" cy="38" r="37.5" pathLength="100"></circle></svg>
      <span class="sp__nums">{d.cards.map((_, i) => <span class="sp__num" data-s-num={i}>{i + 1}/4</span>)}</span>
    </div>

    <!-- D-151: the words are drawn over the card (obsidianassembly.com "The Connection") -->
    <div class="sp__everytext" data-s-etext data-a>
      <p class="sp__the" data-s-the>{d.everyday.the}</p>
      <p class="sp__evword" data-s-evword>{d.everyday.word}</p>
    </div>
    <p class="sp__caption" data-s-caption data-a><span class="sp__capi" data-s-capi>{d.everyday.caption}</span></p>
  </div>
</section>

<style>
  .scene--specs {
    color: var(--ink);
    /* set by specs.ts: the card box (Figma 392 × 602 at 1440 × 900), the hairline y */
    --bw: 392px;
    --bh: 602px;
    --ly: 53.5lvh;
    /* D-153: exposure of the big "The Everyday" photo, one place to tune (also for the D-152 photo):
       brightness of the photo itself, plus an optional warm shade (photo-dim) over it, in %.
       The Rinse card is never touched by either. */
    --ev-exposure: 0.82;
    --ev-shade: 6%;
  }
  .scene--specs .scene__front {
    pointer-events: none;
  }

  /* ---------- the everyday photo: inset frame (Figma 24 / 40, radius 14), moved by specs.ts ---------- */
  .sp__every {
    position: absolute;
    inset: 24px var(--margin);
    border-radius: 14px;
    overflow: hidden;
    will-change: transform;
  }
  /* taller than the frame: its content moves slower than the frame (parallax, specs.ts) */
  .sp__par {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(100% + var(--par, 160px));
    will-change: transform;
    filter: brightness(var(--ev-exposure));
  }
  /* D-153: a light, even warm shade over the photo only (the card sits on the front layer) */
  .sp__evshade {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--photo-dim) var(--ev-shade), transparent);
  }
  .sp__par :global(picture),
  .sp__par :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .sp__dark {
    position: absolute;
    inset: 0;
    background: var(--night);
    opacity: 0;
  }
  .sp__everytext {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--white);
    white-space: nowrap;
    z-index: 75; /* D-151: over the card (cards ≤ 60), under the caption */
    will-change: transform, opacity;
    /* D-150/151: photo and card stay bright; only a soft shadow hugging the letters */
    text-shadow:
      0 0 2px color-mix(in srgb, var(--photo-dim) 30%, transparent),
      0 2px 22px color-mix(in srgb, var(--photo-dim) 42%, transparent),
      0 4px 64px color-mix(in srgb, var(--photo-dim) 26%, transparent);
  }
  /* Display/Display 4; nudged by specs.ts so its T sits flush over the E */
  .sp__the {
    font-weight: var(--w-display);
    font-size: var(--t-display-4-size);
    line-height: var(--t-display-4-lh);
    letter-spacing: var(--t-display-4-ls);
    margin-left: var(--the-x, 0px);
  }
  /* Display/Display 1 */
  .sp__evword {
    font-weight: var(--w-display);
    font-size: var(--t-display-1-size);
    line-height: var(--t-display-1-lh);
    letter-spacing: var(--t-display-1-ls);
  }

  /* ---------- State 1–2 words ---------- */
  /* Display/Display 2 */
  .sp__words {
    position: absolute;
    inset: 0;
    font-weight: var(--w-display);
    font-size: var(--t-display-2-size);
    line-height: var(--t-display-2-lh);
    letter-spacing: var(--t-display-2-ls);
  }
  .sp__w {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    will-change: transform, opacity, clip-path;
  }

  /* ---------- the hairline behind the stack (Figma bg-black 40 %) ---------- */
  .sp__line {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: var(--ly);
    height: 1px;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  /* ---------- the cards: one box (392 × 602), the slot is a clip window inside it ---------- */
  .sp__card {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--bw);
    height: var(--bh);
    margin: 0;
    transform-origin: 50% 50%;
    will-change: transform, clip-path, opacity;
  }
  .sp__card :global(picture),
  .sp__card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- (I)–(IV) text ---------- */
  .sp__text {
    position: absolute;
    inset: 0;
    z-index: 70;
  }
  /* Heading/Heading 2, 16 px above the line; the mask runs down to the line so the letters rise
     from behind it */
  .sp__name {
    position: absolute;
    left: var(--margin);
    bottom: calc(100% - var(--ly));
    font-weight: var(--w-heading);
    font-size: var(--t-heading-2-size);
    line-height: var(--t-heading-2-lh);
    letter-spacing: var(--t-heading-2-ls);
    white-space: nowrap;
  }
  .sp__nmask {
    display: block;
    overflow: hidden;
    padding: 0.1em 0.06em 16px 0;
  }
  .sp__ch {
    display: inline-block;
    white-space: pre;
    will-change: transform;
  }
  .sp__below {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: calc(var(--ly) + 16px);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  /* Paragraph/Large, Ink */
  .sp__ttl,
  .sp__spec {
    font-size: var(--t-para-lg-size);
    line-height: var(--t-para-lg-lh);
    letter-spacing: var(--t-para-lg-ls);
    white-space: pre-line;
  }
  .sp__ttl {
    width: 316px;
  }
  .sp__right {
    width: 316px;
    display: grid;
    justify-items: end;
    gap: 8px;
    text-align: right;
  }
  /* Paragraph/Medium, text-surface */
  .sp__note {
    width: var(--nw);
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    color: var(--stone);
  }
  /* line masks made by specs.ts */
  .sp__text :global(.ln) {
    display: block;
    overflow: hidden;
  }
  .sp__text :global(.lni) {
    display: block;
    will-change: transform;
  }

  /* ---------- counter (Figma 76 px, track + progress, Paragraph/Large) ---------- */
  .sp__count {
    position: absolute;
    right: var(--margin);
    bottom: calc(100% - var(--ly) + 16px);
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    z-index: 70;
  }
  .sp__count svg {
    position: absolute;
    inset: 0;
    overflow: visible;
    rotate: -90deg;
  }
  .sp__count circle {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 16%, transparent);
    stroke-width: 1px;
  }
  .sp__count .sp__arc {
    stroke: var(--ink);
    stroke-dasharray: var(--p, 25) 100;
  }
  .sp__nums {
    display: grid;
    height: var(--t-para-lg-lh);
    overflow: hidden;
  }
  .sp__num {
    grid-area: 1 / 1;
    font-size: var(--t-para-lg-size);
    line-height: var(--t-para-lg-lh);
    letter-spacing: var(--t-para-lg-ls);
    font-variant-numeric: tabular-nums;
    will-change: transform;
  }

  /* ---------- caption: Paragraph/Large, white, free under the right end of "Everyday" ---------- */
  .sp__caption {
    position: absolute;
    left: 0;
    top: 0;
    width: 7em;
    overflow: hidden;
    text-align: right;
    color: var(--white);
    text-shadow:
      0 0 1px color-mix(in srgb, var(--photo-dim) 60%, transparent),
      0 1px 3px color-mix(in srgb, var(--photo-dim) 55%, transparent),
      0 1px 14px color-mix(in srgb, var(--photo-dim) 70%, transparent);
    font-size: var(--t-para-lg-size);
    line-height: var(--t-para-lg-lh);
    letter-spacing: var(--t-para-lg-ls);
    z-index: 80;
  }
  .sp__capi {
    display: block;
    will-change: transform;
  }

  @media (max-width: 719px) {
    .sp__every {
      inset: 16px var(--margin);
    }
    .sp__par :global(img) {
      object-position: 42% 50%;
    }
    .sp__below {
      flex-direction: column;
      gap: 12px;
    }
    .sp__ttl,
    .sp__right {
      width: auto;
    }
    .sp__right {
      justify-items: start;
      gap: 4px;
      text-align: left;
    }
    .sp__note {
      width: auto;
    }
    .sp__count {
      width: 56px;
      height: 56px;
    }
    .sp__caption {
      width: 9em;
    }
  }
</style>
