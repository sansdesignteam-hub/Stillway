---
/**
 * S11 Closing, FAQ & footer — 06:50 tomorrow · Night + a soft light from above (D-098, D-099; colour D-139). References (Figma
 * sticky 40004118:150, Oryzo ×3), Hanken Grotesk with D-082 weights (not Oryzo's heavy face):
 *  - "Choose your own" → states 1–2: the ring in the middle under a warm glow from above (behind the
 *    ring, never over it), one closing line across it — a small caps kicker and one very large line —
 *    then one button and one small line.
 *  - paper → state 3: the FAQ as one narrow column on the same dark, no white panel; one answer open
 *    at a time; the button again under it.
 *  - footer → state 4 (Figma Design State 4, D-165): "Sleep on it. Stillway keeps the pattern." right,
 *    three columns, and STILLWAY in capitals spread across the full width (text only, D-083), shine.
 *  - FAQ answers open by height (grid rows 0fr → 1fr), the + turns into −.
 * No newsletter, no share (D-069). One unbroken dark canvas: the column below moves like a page
 * (scripts/sections/close.ts). FAQ Battery approved in full (D-099).
 */
import { close as d, finishes as f } from '../../content/copy';
---

<section class="scene scene--close" data-scene="close" aria-labelledby="close-title">
  <div class="scene__back">
    <div class="cl__glow" data-cl-glow data-a><canvas class="cl__light" data-cl-light aria-hidden="true"></canvas></div>
  </div>
  <!-- reduced motion / no WebGL: the polished still of the finish chosen in S10 -->
  <img class="ring-fallback cl__fb" src={f.finishes[0].still} alt="" width="1024" height="1024" data-ring-fallback data-fb-range="0,1" data-cl-still data-a loading="lazy" decoding="async" />

  <div class="scene__front">
    <div class="cl__track" data-cl-track>
      <!-- 1–2 · the closing line across the ring, then one button -->
      <div class="cl__block cl__block--hero" data-cl-hero>
        <h2 id="close-title" class="cl__title" data-cl-title data-a>
          <span class="cl__kicker">{d.kicker}</span>{' '}
          <span class="cl__line">{d.line}</span>
        </h2>
        <div class="cl__cta" data-cl-cta data-a>
          <a class="cl__btn" href="#finishes">{d.cta} <span aria-hidden="true">→</span></a>
          <p class="cl__small">{d.ctaLine}</p>
        </div>
      </div>

      <!-- 3 · FAQ: one narrow column on the same dark -->
      <div class="cl__block cl__block--faq" data-cl-faq>
        <h3 class="cl__faqtitle">{d.faqTitle}</h3>
        <ul class="cl__faq">
          {
            d.faq.map((item, i) => (
              <li class="cl__item" data-cl-item>
                <h4>
                  <button type="button" class="cl__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`} data-cl-q>
                    <span>{item.q}</span>
                    <i aria-hidden="true" />
                  </button>
                </h4>
                <div class="cl__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} data-open={i === 0 ? 'true' : 'false'} inert={i !== 0}>
                  <div class="cl__ain"><p>{item.a}</p></div>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="cl__btn" href="#finishes">{d.cta} <span aria-hidden="true">→</span></a>
      </div>

      <!-- 4 · statement, footer, wordmark -->
      <footer class="cl__block cl__block--foot" data-cl-foot>
        <p class="cl__statement">{d.statement}</p>
        <div class="cl__cols">
          <div class="cl__col">
            <p class="cl__sig">{d.signature}</p>
            <p>{d.credit}</p>
            <p class="cl__disc">{d.disclaimer}</p>
          </div>
          <div class="cl__col">
            <p class="cl__dim">{d.contactLabel}</p>
            <p><a href={`mailto:${d.email}`}>E. {d.email}</a></p>
          </div>
          <nav class="cl__col cl__menu" aria-label="Footer">
            {d.menu.map((m) => <a href={m.href}>{m.label}</a>)}
            <a class="cl__top" href="#top">{d.top} ↑</a>
          </nav>
        </div>
        <p class="cl__word" data-cl-word role="img" aria-label={d.wordmark}></p>
      </footer>
    </div>
  </div>
</section>

<style>
  .scene--close {
    color: var(--paper);
    --cream: var(--shine-cream);
  }
  /* a soft light from above, behind the ring (Oryzo); D-139: --cocoa-300, painted with dither
     (scripts/sections/close.ts), where the ochre Ember glow was */
  .cl__glow {
    position: absolute;
    inset: 0;
  }
  .cl__light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cl__fb {
    width: min(38vw, calc(64 * var(--lvh)));
  }
  .cl__track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    will-change: transform;
  }
  .cl__block {
    position: relative;
    padding: 0 var(--margin);
  }
  .cl__block--hero {
    height: calc(100 * var(--svh));
  }
  .cl__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    justify-items: center;
    text-align: center;
    color: var(--cream);
  }
  /* Mono/Large in capitals (QA G-09) */
  .cl__kicker {
    font-weight: var(--w-label);
    font-size: var(--t-mono-lg-size);
    line-height: var(--t-mono-lg-lh);
    letter-spacing: var(--t-mono-lg-ls);
    text-transform: uppercase;
    margin-bottom: 0.4em;
  }
  /* Display/Display 2 */
  .cl__line {
    font-weight: var(--w-display);
    font-size: var(--t-display-2-size);
    line-height: var(--t-display-2-lh);
    letter-spacing: var(--t-display-2-ls);
  }
  .cl__cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--content-bottom) + var(--space-10));
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .cl__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    /* Buttons/Medium */
    font-weight: var(--w-label);
    font-size: var(--t-btn-md-size);
    line-height: var(--t-btn-md-lh);
    letter-spacing: var(--t-btn-md-ls);
    text-decoration: none;
    pointer-events: auto;
    transition: background 0.2s, transform 0.15s;
  }
  .cl__btn:hover {
    background: var(--cream);
  }
  .cl__btn:active {
    transform: scale(0.98);
  }
  /* Paragraph/Small */
  .cl__small {
    font-size: var(--t-para-sm-size);
    line-height: var(--t-para-sm-lh);
    letter-spacing: var(--t-para-sm-ls);
    color: var(--stone-on-night);
  }
  /* FAQ: one narrow column on the same dark */
  .cl__block--faq {
    width: min(40rem, 100%);
    margin: 0 auto;
    padding-top: var(--content-top);
    padding-bottom: calc(14 * var(--lvh));
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  /* Heading/Heading 1 */
  .cl__faqtitle {
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
    margin-bottom: 8px;
  }
  .cl__faq {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .cl__item {
    border-top: 1px solid var(--line-on-night);
  }
  .cl__item:last-child {
    border-bottom: 1px solid var(--line-on-night);
  }
  .cl__q {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: var(--space-4) 0;
    border: 0;
    background: none;
    color: var(--paper);
    font: inherit;
    /* Label/Medium */
    font-weight: var(--w-label);
    font-size: var(--t-label-md-size);
    line-height: var(--t-label-md-lh);
    letter-spacing: var(--t-label-md-ls);
    text-align: left;
    cursor: pointer;
    pointer-events: auto;
  }
  .cl__q i {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  /* + turns into − by a quarter turn of the whole mark and of its upright bar (D-165) */
  .cl__q i {
    transition: rotate 0.32s var(--ease-out, ease);
  }
  .cl__q i::before,
  .cl__q i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: rotate 0.32s var(--ease-out, ease), opacity 0.32s;
  }
  .cl__q i::after {
    rotate: 90deg;
  }
  .cl__q[aria-expanded='true'] i {
    rotate: 180deg;
  }
  .cl__q[aria-expanded='true'] i::after {
    rotate: 180deg;
    opacity: 0;
  }
  /* the answer opens by its height: grid rows 0fr → 1fr (D-165), no layout jump */
  .cl__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.32s var(--ease-out, ease);
  }
  .cl__a[data-open='true'] {
    grid-template-rows: 1fr;
  }
  .cl__ain {
    min-height: 0;
    overflow: hidden;
  }
  .cl__ain p {
    opacity: 0;
    translate: 0 -4px;
    transition: opacity 0.24s ease, translate 0.32s var(--ease-out, ease);
  }
  .cl__a[data-open='true'] .cl__ain p {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.06s;
  }
  :global(html.reduced) .cl__a,
  :global(html.reduced) .cl__ain p,
  :global(html.reduced) .cl__q i,
  :global(html.reduced) .cl__q i::before,
  :global(html.reduced) .cl__q i::after {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cl__a,
    .cl__ain p,
    .cl__q i,
    .cl__q i::before,
    .cl__q i::after {
      transition: none;
    }
  }
  .cl__a p {
    padding: 0 0 20px;
    /* Paragraph/Medium */
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    max-width: 34em;
  }
  /* footer on the same canvas — Figma Design "11 · Closing, FAQ & footer" State 4 (40004265:1480):
     the line right at the top, three columns on the 12-column grid (1–5, 6–9, 10–12), the logo
     lockup at the foot (D-165, D-183) */
  /* D-171: the footer is as tall as its content (no full-screen height, no empty band above the
     wordmark); the last scroll stop puts its bottom on the bottom of the screen (close.ts) */
  .cl__block--foot {
    padding-top: calc(var(--header-h) + var(--space-10));
    display: grid;
    grid-template-rows: auto auto auto;
    row-gap: var(--space-9);
    overflow: hidden;
  }
  /* Heading/Heading 1, cream, right (Figma 1000 px box) */
  .cl__statement {
    justify-self: end;
    width: min(1000px, 100%);
    text-align: right;
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
    color: var(--cream);
  }
  .cl__cols {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: var(--grid);
    column-gap: var(--gutter);
    /* Paragraph/Small */
    font-size: var(--t-para-sm-size);
    line-height: var(--t-para-sm-lh);
    letter-spacing: var(--t-para-sm-ls);
  }
  .cl__col {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .cl__cols > :nth-child(1) {
    grid-column: 1 / span 5;
  }
  .cl__cols > :nth-child(2) {
    grid-column: 6 / span 4;
  }
  .cl__cols > :nth-child(3) {
    grid-column: 10 / span 3;
  }
  /* Mono/Medium (Figma), Hanken Grotesk (QA G-09) */
  .cl__sig {
    font-weight: var(--w-label);
    font-size: var(--t-mono-md-size);
    line-height: var(--t-mono-md-lh);
    letter-spacing: var(--t-mono-md-ls);
  }
  .cl__disc,
  .cl__dim {
    color: var(--stone-on-night);
    max-width: 420px;
  }
  .cl__block--foot a {
    color: var(--paper);
    text-decoration: none;
    pointer-events: auto;
  }
  .cl__block--foot a:hover {
    text-decoration: underline;
  }
  .cl__menu {
    justify-items: start;
  }
  .cl__top {
    margin-top: 10px;
  }
  /* D-183b: lockup 03A across the full content width (margin to margin), height from its own ratio.
     The shape is a mask, so the hover shine still sweeps across it */
  .cl__word {
    grid-row: 4;
    margin: 24px 0 calc(var(--t-display-1-size) * 0.04);
    justify-self: stretch;
    min-width: 0;
    aspect-ratio: 204.76 / 38.55;
    -webkit-mask: url('../../assets/stillway-lockup-03a.svg') left center / contain no-repeat;
    mask: url('../../assets/stillway-lockup-03a.svg') left center / contain no-repeat;
    pointer-events: auto;
    background-color: var(--cream);
    background-image: linear-gradient(110deg, var(--cream) 0%, var(--cream) 40%, var(--white) 47%, var(--shine-amber) 53%, var(--cream) 60%, var(--cream) 100%);
    background-size: 300% 100%;
    background-position: 100% 0;
  }
  .cl__word.is-shine {
    animation: cl-shine 0.9s ease-in-out 1;
  }
  @keyframes cl-shine {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }
  :global(html.reduced) .cl__word {
    animation: none;
    transition: filter 0.3s;
  }
  :global(html.reduced) .cl__word:hover {
    filter: brightness(1.12);
  }
  .cl__btn:focus-visible,
  .cl__q:focus-visible,
  .cl__block--foot a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  @media (max-width: 719px) {
    .cl__cta {
      bottom: calc(10 * var(--lvh));
      padding: 0 var(--margin);
      text-align: center;
    }
    .cl__q {
      padding: 15px 0;
    }
    /* QA M-07: the closing line never runs past 335 px */
    .cl__title {
      width: min(335px, calc(100vw - 40px));
      margin-inline: auto;
    }
    .cl__line {
      font-size: min(var(--t-display-2-size), 16.5vw);
      line-height: 0.98;
      text-wrap: balance;
    }

    .cl__block--foot {
      padding-top: calc(var(--header-h) + var(--space-7));
      row-gap: var(--space-8);
    }
    .cl__statement {
      width: 100%;
    }
    /* QA M-07: the footer never widens past the screen */
    .cl__block--foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .cl__cols {
      margin-top: 0;
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }
    .cl__cols > :nth-child(1) {
      grid-column: 1 / -1;
    }
    /* phones: contact on its own row (the address stays on one line), the menu under it */
    .cl__cols > :nth-child(2),
    .cl__cols > :nth-child(3) {
      grid-column: 1 / -1;
    }
  }
</style>
