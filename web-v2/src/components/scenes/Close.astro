---
/**
 * S11 Closing, FAQ & footer — 06:50 tomorrow · Night + Ember glow (D-098, D-099). References (Figma
 * sticky 40004118:150, Oryzo ×3), Geist with D-082 weights (not Oryzo's heavy face):
 *  - "Choose your own" → states 1–2: the ring in the middle under a warm glow from above (behind the
 *    ring, never over it), one closing line across it — a small caps kicker and one very large line —
 *    then one button and one small line.
 *  - paper → state 3: the FAQ as one narrow column on the same dark, no white panel; one answer open
 *    at a time; the button again under it.
 *  - footer → state 4: a caps statement and the footer on the same canvas, ending with the full-width
 *    "Stillway" wordmark (text only, D-083), cut a little at the bottom, with a hover shine.
 * No newsletter, no share (D-069). One unbroken dark canvas: the column below moves like a page
 * (scripts/sections/close.ts). FAQ Battery approved in full (D-099).
 */
import { close as d, finishes as f } from '../../content/copy';
---

<section class="scene scene--close" data-scene="close" aria-labelledby="close-title">
  <div class="scene__back">
    <div class="cl__glow" data-cl-glow data-a></div>
  </div>
  <!-- reduced motion / no WebGL: the polished still of the finish chosen in S10 -->
  <img class="ring-fallback cl__fb" src={f.finishes[0].still} alt="" width="1024" height="1024" data-ring-fallback data-fb-range="0,1" data-cl-still data-a loading="lazy" decoding="async" />

  <div class="scene__front">
    <div class="cl__track" data-cl-track>
      <!-- 1–2 · the closing line across the ring, then one button -->
      <div class="cl__block cl__block--hero" data-cl-hero>
        <h2 id="close-title" class="cl__title" data-cl-title data-a>
          <span class="cl__kicker">{d.kicker}</span>
          <span class="cl__line">{d.line}</span>
        </h2>
        <div class="cl__cta" data-cl-cta data-a>
          <a class="cl__btn" href="#finishes">{d.cta} <span aria-hidden="true">→</span></a>
          <p class="cl__small">{d.ctaLine}</p>
        </div>
      </div>

      <!-- 3 · FAQ: one narrow column on the same dark -->
      <div class="cl__block cl__block--faq" data-cl-faq>
        <h3 class="cl__faqtitle">{d.faqTitle}</h3>
        <ul class="cl__faq">
          {
            d.faq.map((item, i) => (
              <li class="cl__item" data-cl-item>
                <h4>
                  <button type="button" class="cl__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`} data-cl-q>
                    <span>{item.q}</span>
                    <i aria-hidden="true" />
                  </button>
                </h4>
                <div class="cl__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden={i !== 0}>
                  <p>{item.a}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="cl__btn" href="#finishes">{d.cta} <span aria-hidden="true">→</span></a>
      </div>

      <!-- 4 · statement, footer, wordmark -->
      <footer class="cl__block cl__block--foot" data-cl-foot>
        <p class="cl__statement">{d.statement}</p>
        <div class="cl__cols">
          <div class="cl__col">
            <p class="cl__sig">{d.signature}</p>
            <p>{d.credit}</p>
            <p class="cl__disc">{d.disclaimer}</p>
          </div>
          <div class="cl__col">
            <p class="cl__dim">{d.contactLabel}</p>
            <p><a href={`mailto:${d.email}`}>E. {d.email}</a></p>
          </div>
          <nav class="cl__col cl__menu" aria-label="Footer">
            {d.menu.map((m) => <a href={m.href}>{m.label}</a>)}
            <a class="cl__top" href="#top">{d.top} ↑</a>
          </nav>
        </div>
        <p class="cl__word" data-cl-word aria-label={d.wordmark}><span aria-hidden="true">{d.wordmark}</span></p>
      </footer>
    </div>
  </div>
</section>

<style>
  .scene--close {
    color: var(--paper);
    --cream: var(--paper); /* text on Night = Paper (Moodboard §2.6); the wordmark keeps the shine cream */
  }
  /* Ember glow from above, behind the ring (Oryzo) */
  .cl__glow {
    position: absolute;
    left: 50%;
    top: -38vh;
    width: min(120vw, 1500px);
    height: 110vh;
    translate: -50% 0;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ochre) 62%, transparent), color-mix(in srgb, var(--ochre) 22%, transparent) 45%, transparent 100%);
  }
  .cl__fb {
    width: min(38vw, 64vh);
  }
  .cl__track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    will-change: transform;
  }
  .cl__block {
    position: relative;
    padding: 0 var(--margin);
  }
  .cl__block--hero {
    height: 100svh;
  }
  .cl__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    justify-items: center;
    text-align: center;
    color: var(--cream);
  }
  .cl__kicker {
    /* Mono/Medium eyebrow */
    font-family: var(--font-mono);
    font-size: var(--mono-md-fs);
    line-height: var(--mono-md-lh);
    font-weight: var(--w-medium);
    letter-spacing: var(--mono-ls);
    text-transform: uppercase;
    margin-bottom: 0.4em;
  }
  .cl__line {
    /* Display/Display 2 (G-09: 158 → 160) */
    font-size: var(--d2-fs);
    font-weight: var(--w-medium);
    letter-spacing: var(--d-ls);
    line-height: var(--d2-lh);
  }
  .cl__cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .cl__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 26px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    /* Buttons/Medium */
    font-size: var(--btn-md-fs);
    line-height: var(--btn-md-lh);
    font-weight: var(--w-medium);
    text-decoration: none;
    pointer-events: auto;
    transition: background 0.2s, transform 0.15s;
  }
  .cl__btn:hover {
    background: var(--cream);
  }
  .cl__btn:active {
    transform: scale(0.98);
  }
  .cl__small {
    font-size: var(--para-sm-fs);
    line-height: var(--para-sm-lh);
    color: var(--stone-on-night);
  }
  /* FAQ: one narrow column on the same dark */
  .cl__block--faq {
    width: min(40rem, 100%);
    margin: 0 auto;
    padding-top: calc(var(--header-h) + 6vh);
    padding-bottom: 14vh;
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .cl__faqtitle {
    /* Heading/Heading 1 (G-09: 52 → 56) */
    font-size: var(--h1-fs);
    font-weight: var(--w-medium);
    letter-spacing: var(--h1-ls);
    line-height: var(--h1-lh);
    margin-bottom: 8px;
  }
  .cl__faq {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .cl__item {
    border-top: 1px solid var(--line-on-night);
  }
  .cl__item:last-child {
    border-bottom: 1px solid var(--line-on-night);
  }
  .cl__q {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 18px 0;
    border: 0;
    background: none;
    color: var(--paper);
    /* Label/Medium (FAQ question) */
    font: var(--w-medium) var(--label-md-fs) / var(--label-md-lh) var(--font-sans);
    text-align: left;
    cursor: pointer;
    pointer-events: auto;
  }
  .cl__q i {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .cl__q i::before,
  .cl__q i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    background: currentColor;
    transition: rotate 0.25s ease;
  }
  .cl__q i::after {
    rotate: 90deg;
  }
  .cl__q[aria-expanded='true'] i::after {
    rotate: 0deg;
  }
  .cl__a p {
    padding: 0 0 20px;
    font-size: var(--para-md-fs);
    line-height: var(--para-md-lh);
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    max-width: 34em;
  }
  /* footer on the same canvas */
  .cl__block--foot {
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 6vh);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 6vh;
    overflow: hidden;
  }
  .cl__statement {
    justify-self: end;
    width: min(16em, 100%);
    text-align: right;
    /* Heading/Heading 1, sentence case (Storyboard S11 State 4, D-119) */
    font-size: var(--h1-fs);
    font-weight: var(--w-medium);
    letter-spacing: var(--h1-ls);
    line-height: var(--h1-lh);
    color: var(--cream);
  }
  .cl__cols {
    align-self: end;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 32px;
    font-size: var(--para-sm-fs);
    line-height: var(--para-sm-lh);
  }
  .cl__col {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .cl__sig {
    /* Mono/Small (the signature line is set in capitals) */
    font-family: var(--font-mono);
    font-size: var(--mono-sm-fs);
    line-height: var(--mono-sm-lh);
    font-weight: var(--w-regular);
    letter-spacing: var(--mono-ls);
    text-transform: uppercase;
  }
  .cl__disc,
  .cl__dim {
    color: var(--stone-on-night);
    max-width: 30em;
  }
  .cl__block--foot a {
    color: var(--paper);
    text-decoration: none;
    pointer-events: auto;
  }
  .cl__block--foot a:hover {
    text-decoration: underline;
  }
  .cl__menu {
    justify-items: start;
  }
  .cl__top {
    margin-top: 10px;
  }
  /* the wordmark across the screen, cut a little at the bottom, with a hover shine */
  .cl__word {
    margin: 0 calc(var(--margin) * -0.2) -0.22em;
    font-size: 25.5vw;
    /* footer wordmark: full width (capital "STILLWAY" + Display 1 = C-01, phase 4) */
    font-weight: var(--w-medium);
    letter-spacing: -0.045em;
    line-height: 0.8;
    white-space: nowrap;
    pointer-events: auto;
    color: var(--cream);
    background-image: linear-gradient(110deg, var(--shine-cream) 0%, var(--shine-cream) 40%, var(--white) 47%, var(--shine-amber) 53%, var(--shine-cream) 60%, var(--shine-cream) 100%);
    background-size: 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .cl__word.is-shine {
    animation: cl-shine 0.9s ease-in-out 1;
  }
  @keyframes cl-shine {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }
  :global(html.reduced) .cl__word {
    animation: none;
    transition: filter 0.3s;
  }
  :global(html.reduced) .cl__word:hover {
    filter: brightness(1.12);
  }
  .cl__btn:focus-visible,
  .cl__q:focus-visible,
  .cl__block--foot a:focus-visible {
    outline: 2px solid var(--ochre);
    outline-offset: 3px;
  }
  @media (max-width: 719px) {
    .cl__line {
    }
    .cl__cta {
      bottom: 10vh;
      padding: 0 var(--margin);
      text-align: center;
    }
    .cl__small {
    }
    .cl__q {
      padding: 15px 0;
    }
    .cl__a p {
    }
    .cl__statement {
    }
    .cl__cols {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .cl__cols .cl__col:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
