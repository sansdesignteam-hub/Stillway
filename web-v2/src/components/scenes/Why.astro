---
/** S02 Why Stillway scene. Motion: scripts/sections/why.ts. Layout: HANDOFF-v2 §2 S02 [U]. */
import { why } from '../../content/copy';
const last = why.steps[why.steps.length - 1];
---

<section class="scene scene--why" data-scene="why" aria-labelledby="why-title">
  <div class="scene__back">
    <p class="why__word giant" data-w-word data-a aria-hidden="true">{why.backWord}</p>
    <p class="why__wide giant" data-w-wide data-a aria-hidden="true">{why.wide}</p>
  </div>
  <img class="ring-fallback ring-fallback--why" src="/ring-fallback/fb-s02-34.webp" alt="" width="1024" height="1024" data-ring-fallback data-a loading="lazy" decoding="async" />
  <div class="scene__front">
    <p class="why__label t-mono" data-w-label data-a>{why.label}</p>
    <h2 id="why-title" class="sr-only">{why.label}</h2>
    <p class="why__final" data-w-final data-a><span>{last.big}</span></p>
    <div class="why__left">
      <p class="why__prev" data-w-prev data-a aria-hidden="true">{why.steps[0].big}</p>
      <div class="why__bigs">
        {why.steps.slice(0, 2).map((s) => <p class="why__big t-display" data-w-big data-a>{s.big}</p>)}
      </div>
    </div>
    <div class="why__right">
      {why.steps.slice(0, 2).map((s) => <p class="why__small" data-w-small data-a>{s.small}</p>)}
    </div>
    <p class="why__small why__end" data-w-small data-a>{last.small}</p>
  </div>
</section>

<style>
  .why__word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    --giant-o: 0.1;
  }
  .why__wide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 12vw; /* Sofi ref: edge to edge behind the ring (12vw at weight 500, D-082) */
    white-space: nowrap;
    --giant-o: 1;
  }
  .why__label {
    position: absolute;
    left: var(--margin);
    top: calc(var(--header-h) + 32px);
    color: var(--ochre);
    transition: color 0.3s ease;
  }
  .why__label:global(.is-quiet) {
    color: var(--stone);
  }
  .why__final {
    position: absolute;
    left: var(--margin);
    top: calc(var(--header-h) + 64px);
    font-size: var(--fs-h3);
    font-weight: var(--w-heading);
    letter-spacing: var(--track-tight);
    line-height: 1.15;
  }
  .why__final span {
    text-decoration: underline;
    text-decoration-color: var(--ochre);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .why__left {
    position: absolute;
    left: var(--margin);
    top: 50%;
    translate: 0 -50%;
    width: calc((100vw - 2 * var(--margin)) * 4 / 12);
  }
  .why__big {
    /* Oryzo ref: a short statement block beside the object, not a wall of type */
    font-size: clamp(2.5rem, 1.2rem + 3.4vw, 4.25rem);
    line-height: 1;
  }
  .why__bigs {
    display: grid;
    align-items: start;
  }
  .why__bigs > * {
    grid-area: 1 / 1;
  }
  .why__prev {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 20px);
    font-size: var(--fs-h3);
    font-weight: var(--w-heading);
    letter-spacing: var(--track-tight);
    color: var(--stone);
  }
  .why__right {
    position: absolute;
    right: var(--margin);
    top: 50%;
    width: calc((100vw - 2 * var(--margin)) * 3 / 12);
    display: grid;
  }
  .why__right > * {
    grid-area: 1 / 1;
  }
  .why__small {
    color: var(--stone);
  }
  .why__end {
    position: absolute;
    right: var(--margin);
    bottom: clamp(32px, 9vh, 96px);
    width: calc((100vw - 2 * var(--margin)) * 3 / 12);
  }
  @media (max-width: 719px) {
    .why__word {
      place-items: center;
    }
    .why__wide {
      white-space: normal;
      text-align: center;
      font-size: var(--fs-giant);
      line-height: 0.85;
      padding: 0 8px;
    }
    .why__left {
      top: calc(var(--header-h) + 128px);
      translate: none;
      right: var(--margin);
      width: auto;
    }
    .why__left .why__big {
      font-size: var(--fs-h2m);
    }
    .why__prev {
      bottom: calc(100% + 10px);
      font-size: 1rem;
    }
    .why__right,
    .why__end {
      top: auto;
      right: var(--margin);
      bottom: 28px;
      left: var(--margin);
      width: auto;
    }
    .why__final {
      font-size: 1.25rem;
    }
  }
</style>
