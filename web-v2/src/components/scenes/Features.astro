---
/**
 * S08 Features — 21:00 · Night (D-154: Figma Design 08 State 1–4, 40004264:914 / :955 / :1009,
 * 40004334:3583).
 *  - State 1 "Inside the ring." — the ring floats in the middle, window A a faint green hint.
 *  - State 2 "One light, tuned to the task." — the camera close to the window (big ring right,
 *    three-quarter), green = Heart rate; a 3-colour legend (labels, not buttons).
 * D-156: all text neutral and in Hanken Grotesk (no ochre, no Geist Mono, no [ ] on the kicker).
 *  - State 3 "Blue at night. Violet by morning." — same place, blue (±75 %) then violet (100 %);
 *    one small line "Red means it's off."
 *  - State 4 "Red means it's off." — the small red light in the lower window (off / battery empty);
 *    the three modes dim.
 * The lights are mode status, not sensor claims (D-062); LED colours from the --led-* tokens; the
 * ring stays neutral (D-141) under a weak cocoa light from above (D-139).
 * Left column: kicker + title + legend + note, centred under the navbar (Figma "Content"); phones:
 * title on top, legend and note at the bottom, the ring between.
 * Motion: scripts/sections/features.ts; the ring and its lights: ring/stage.ts (pose.ledc 0 → 3).
 */
import { features as d } from '../../content/copy';

// reduced motion / no WebGL: the 3D Designer's v3 stills of the close pose (fallback-v3 README):
// image width 1.2587 × ring width, centred on the ring pivot (W/2 + 0.25 W, H/2 + 0.04 H)
const stills = [
  { src: '/ring-fallback/fb-s08-green-polished.webp', range: '0,1' },
  { src: '/ring-fallback/fb-s08-violet-polished.webp', range: '2,2' },
  { src: '/ring-fallback/fb-s08-red-polished.webp', range: '3,3' },
];
---

<section class="scene scene--features" data-scene="features" aria-labelledby="features-title">
  <!-- D-139: a weak --cocoa-300 light from above, behind the ring; kept low so the sensor colours lead -->
  <div class="scene__back">
    <canvas class="ft__light" data-f-light data-a aria-hidden="true"></canvas>
  </div>
  {stills.map((s) => <img class="ring-fallback ft__fb" src={s.src} alt="" width="1024" height="1024" data-ring-fallback data-fb-range={s.range} data-a loading="lazy" decoding="async" />)}
  <div class="scene__front">
    <p class="sr-only">{d.alt}</p>
    <div class="ft__col" data-f-col>
      <div class="ft__top" data-f-top>
        <p class="ft__kick" aria-hidden="true">
          {d.kickers.map((k, i) => <span data-f-kick={i} data-a>{k}</span>)}
        </p>
        <h2 id="features-title" class="ft__heads">
          {
            d.heads.map((h, i) => (
              <span class="ft__head" data-f-head={i} data-a>
                {h}{' '}
              </span>
            ))
          }
        </h2>
      </div>
      <div class="ft__bottom" data-f-bottom data-a>
        <ul class="ft__legend">
          {
            d.legend.map((l, i) => (
              <li data-f-leg={i} class={`ft__leg ft__leg--${l.key}`}>
                <i aria-hidden="true" />
                <span class="ft__label">{l.label}</span>
                <span class="ft__detail">{l.detail}</span>
              </li>
            ))
          }
        </ul>
        <p class="ft__off" data-f-offwrap data-a>
          <i aria-hidden="true"></i>
          <span class="ft__offtxt">
            <span data-f-off="0" data-a>{d.off}</span>
            <span data-f-off="1" data-a>{d.offLong}</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .scene--features {
    color: var(--white);
  }
  .ft__light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* v3 still of the close pose (README: 1160 px at 1440, left 500, top −94) */
  .ft__fb {
    left: 75%;
    top: 54%;
    width: 80.56vw;
    max-width: none;
  }

  /* ---------- the column (Figma "Content": x 40, centred between the navbar and 40 px from the bottom) ---------- */
  .ft__col {
    position: absolute;
    left: var(--margin);
    top: var(--header-h);
    bottom: 40px;
    width: min(520px, calc(100vw - 2 * var(--margin)));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px; /* Figma: gap 16 + legend padding 24 */
    will-change: transform;
  }
  .ft__top {
    display: grid;
    gap: 16px;
  }
  /* Label/X-Small in capitals, Paper 65 % (D-156: neutral, no brackets, no mono) */
  .ft__kick {
    display: grid;
    font-weight: var(--w-label);
    font-size: var(--t-label-xs-size);
    line-height: var(--t-label-xs-lh);
    letter-spacing: var(--t-caps-ls);
    text-transform: uppercase;
    color: var(--stone-on-night);
    white-space: nowrap;
  }
  .ft__kick span {
    grid-area: 1 / 1;
  }
  /* Heading/Heading 1, white; the four titles share one cell */
  .ft__heads {
    display: grid;
    font-weight: var(--w-heading);
    font-size: var(--t-heading-1-size);
    line-height: var(--t-heading-1-lh);
    letter-spacing: var(--t-heading-1-ls);
  }
  .ft__head {
    grid-area: 1 / 1;
  }
  .ft__bottom {
    display: grid;
    gap: 24px;
  }
  /* legend: labels, not buttons (Figma gap 12; dot 10; Paragraph/Medium + Mono/Small) */
  .ft__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .ft__leg {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: var(--on, 0.4);
    white-space: nowrap;
  }
  .ft__leg i {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 calc(10px * var(--glow, 0)) var(--c);
  }
  .ft__leg--green {
    --c: var(--led-heart-rate);
  }
  .ft__leg--blue {
    --c: var(--led-sleep);
  }
  .ft__leg--violet {
    --c: var(--led-recovery);
  }
  .ft__label {
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
  }
  /* Label/X-Small, Paper 65 % (Figma Mono/Small, D-156) */
  .ft__detail {
    font-weight: var(--w-label);
    font-size: var(--t-label-xs-size);
    line-height: var(--t-label-xs-lh);
    letter-spacing: var(--t-label-xs-ls);
    color: var(--stone-on-night);
  }
  /* off note (D-158): on the legend's grid — the same 10 px dot in the same column, the same 12 px
     to the text, the same Paragraph/Medium as the labels above */
  .ft__off {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--t-para-md-size);
    line-height: var(--t-para-md-lh);
    letter-spacing: var(--t-para-md-ls);
  }
  .ft__off i {
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: calc((var(--t-para-md-lh) - 10px) / 2);
    border-radius: 50%;
    background: var(--led-off);
    box-shadow: 0 0 calc(8px * var(--glow, 0)) var(--led-off);
  }
  .ft__offtxt {
    display: grid;
  }
  .ft__offtxt span {
    grid-area: 1 / 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 719px) {
    .ft__fb {
      left: 72%;
      top: 70%;
      width: 116vw;
    }
    /* phones (Figma pattern): title on top, legend + note at the bottom, the ring between */
    .ft__col {
      top: calc(var(--header-h) + 16px);
      bottom: auto;
      right: var(--margin);
      width: auto;
      /* QA M-04: the legend sits above the ring, so all of it is always on screen */
      justify-content: flex-start;
      gap: 20px;
    }
    .ft__top {
      gap: 10px;
    }
    .ft__bottom {
      gap: 14px;
    }
    .ft__legend {
      gap: 8px;
    }
  }
</style>
