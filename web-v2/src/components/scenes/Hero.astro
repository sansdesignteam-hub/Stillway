---
/** S01 Hero scene. Motion: scripts/sections/hero.ts. Layout: HANDOFF-v2 §2 S01 [U]. */
import { hero } from '../../content/copy';
---

<section class="scene scene--hero" data-scene="hero" aria-labelledby="hero-title">
  <div class="scene__back">
    <div class="hero__glow" data-h-glow data-a></div>
    <p class="hero__word giant" data-h-word data-a aria-hidden="true">{hero.wordmark}</p>
  </div>
  <img class="ring-fallback ring-fallback--hero" src="/ring-fallback/fb-s01-34.webp" alt="" width="1024" height="1024" data-ring-fallback data-a loading="eager" decoding="async" />
  <div class="scene__front">
    <span class="sr-only" role="img" aria-label={hero.ringAlt}></span>
    <div class="hero__copy" data-h-copy data-a>
      <p class="t-mono hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="t-display">{hero.headline}</h1>
      <p class="hero__sub">{hero.sub}</p>
      <a class="link-arrow" href={hero.link.href}>{hero.link.label}<span aria-hidden="true"> →</span></a>
    </div>
    <p class="hero__hint t-mono" data-h-hint data-a aria-hidden="true">{hero.scroll}</p>
  </div>
</section>

<style>
  .hero__glow {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 72vw; /* Viture ref: one soft glow rising behind the ring */
    aspect-ratio: 1;
    translate: -50% -50%;
    background: var(--dawn-glow);
    filter: blur(70px);
  }
  .hero__word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    --giant-o: 0.12; /* Oryzo ref: a giant wordmark behind the object, kept faint (Storyboard) */
  }
  .hero__copy {
    position: absolute;
    left: var(--margin);
    bottom: clamp(32px, 7vh, 72px);
    width: min(36rem, 42vw);
    display: grid;
    gap: 16px;
  }
  .hero__eyebrow {
    color: var(--ochre);
  }
  .hero__sub {
    color: var(--stone);
    max-width: 30rem;
  }
  .hero__hint {
    position: absolute;
    right: calc(var(--margin) + 24px);
    bottom: clamp(32px, 7vh, 72px);
    color: var(--stone);
  }
  @media (max-width: 719px) {
    .hero__glow {
      width: 120vw;
      top: 36%;
    }
    .hero__word {
      place-items: start center;
      padding-top: 23svh;
    }
    .hero__copy {
      width: auto;
      right: var(--margin);
      bottom: 28px;
      gap: 12px;
    }
    .hero__hint {
      display: none;
    }
  }
</style>
