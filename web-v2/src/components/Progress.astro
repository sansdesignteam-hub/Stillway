---
/**
 * QA HE-02 (D-169, revised D-171): global page progress, minimal like VITURE Mobile Dock Mini.
 * 11 small dots in a column fixed on the left edge, one per section; the current section is a short
 * horizontal line. Black on light grounds, white on dark ones and on the photo; inactive dots at a
 * soft opacity. It shows while the page scrolls and hides after 2.5 s without scrolling (story.ts).
 * A position marker only: no links, hidden from assistive tech (the navbar chapter, the clock and
 * the URL hash already say where you are). Driven by story.ts from the same section as the clock.
 */
import { sections } from '../content/sections';
---

<div class="gprog" data-gprog aria-hidden="true">
  {sections.map((d, i) => <i class:list={{ 'is-on': i === 0 }} data-id={d.id}></i>)}
</div>

<style>
  .gprog {
    --c: var(--text-strong);
    position: fixed;
    z-index: 40; /* above the stage, under the navbar and its menu */
    left: calc((var(--margin) - 8px) / 2);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    justify-items: start;
    gap: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .gprog:global(.is-awake) {
    opacity: 1;
  }
  :global(html[data-surface='dark']) .gprog,
  :global(html[data-surface='photo']) .gprog {
    --c: var(--text-white);
  }
  .gprog i {
    display: block;
    width: 3px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--c);
    opacity: 0.4;
    transition:
      width 0.3s var(--ease-out),
      opacity 0.3s ease,
      background-color 0.3s ease;
  }
  .gprog i.is-on {
    width: 8px;
    height: 2px;
    opacity: 1;
  }
  @media (max-width: 719px) {
    .gprog {
      left: 4px;
      gap: 8px;
    }
    .gprog i.is-on {
      width: 6px;
    }
  }
  :global(html.reduced) .gprog,
  :global(html.reduced) .gprog i {
    transition: none;
  }
</style>
