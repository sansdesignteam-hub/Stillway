---
/**
 * The fixed stage (D-063, panel model D-120). Layers, back to front:
 *   section panels (backgrounds, injected by story.ts; later sections above earlier ones) — z 0
 *   scene back layers (giant words, glow, ring stills)                                    — z 1
 *   the WebGL ring canvas (one sticky ring, never faded)                                    — z 2
 *   scene front layers (copy, numbers)                                                      — z 3
 * A panel rises from the bottom with a straight edge; the layers of the section below are clipped
 * at that edge (story.ts). Scenes must never get opacity/transform/clip themselves (that would
 * create a stacking context and pull their back text in front of the ring); story.ts animates
 * their children only.
 */
---

<div class="stage">
  <canvas class="stage__ring" data-ring-canvas aria-hidden="true"></canvas>
  <main id="main" class="stage__scenes" tabindex="-1">
    <slot />
  </main>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    height: 100lvh;
    pointer-events: none;
    background: var(--paper);
  }
  .stage__ring {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  /* the ring appears once, on load, when the GLB, polished finish and S01 env are ready (D-083);
     after that it is never faded again (D-120) */
  :global(html.ring-ready) .stage__ring {
    opacity: 1;
  }
  :global(html.ring-live) .stage__ring {
    transition: none;
  }
  .stage__scenes {
    position: absolute;
    inset: 0;
    height: 100svh;
    outline: none;
  }
</style>
