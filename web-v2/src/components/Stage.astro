---
/**
 * The fixed stage (D-063). Layers, back to front:
 *   bg (section colour, cross-faded by story.ts) · dusk overlay
 *   scene back layers (giant words, glow)  — z 1
 *   the WebGL ring canvas                   — z 2
 *   scene front layers (copy, numbers)      — z 3
 * Scenes must never get opacity/transform themselves (that would create a stacking context and
 * pull their back text in front of the ring); story.ts animates their children only.
 */
---

<div class="stage">
  <div class="stage__bg" data-bg></div>
  <div class="stage__dusk" data-dusk></div>
  <div class="stage__wipe" data-wipe></div>
  <canvas class="stage__ring" data-ring-canvas aria-hidden="true"></canvas>
  <main id="main" class="stage__scenes" tabindex="-1">
    <slot />
  </main>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    height: 100lvh;
    pointer-events: none;
  }
  .stage__bg,
  .stage__dusk {
    position: absolute;
    inset: 0;
    background: var(--paper);
  }
  .stage__dusk {
    background: var(--dusk);
    opacity: 0;
  }
  /* Dusk → Paper (D-093): light sweeps down — paper, sand, a warm ochre edge, then clear — so the
     middle of the change is a sunset band, never a grey mix of Night and Paper */
  .stage__wipe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 250lvh;
    background: linear-gradient(
      to bottom,
      var(--paper) 0%,
      var(--paper) 56%,
      var(--sand) 63%,
      color-mix(in srgb, color-mix(in srgb, var(--ochre) 50%, var(--sand)) 90%, transparent) 69%,
      color-mix(in srgb, var(--ochre) 45%, transparent) 75%,
      transparent 84%
    );
    visibility: hidden;
    will-change: transform;
  }
  .stage__wipe[data-tone='rise'] {
    background: linear-gradient(to top, var(--night) 0%, var(--night) 56%, color-mix(in srgb, var(--ochre) 55%, transparent) 64%, color-mix(in srgb, var(--ochre) 20%, transparent) 72%, transparent 82%);
  }
  /* D-136 (02 → 03): Night rising from below through warm Cocoa steps into the Paper above */
  .stage__wipe[data-tone='rise-cocoa'] {
    background: linear-gradient(
      to top,
      var(--night) 0%,
      var(--night) 40%,
      var(--cocoa-900) 47%,
      var(--cocoa-700) 54%,
      color-mix(in srgb, var(--cocoa-500) 85%, transparent) 61%,
      color-mix(in srgb, var(--cocoa-300) 45%, transparent) 70%,
      transparent 80%
    );
  }
  .stage__wipe[data-tone='plain'] {
    background: linear-gradient(to bottom, var(--paper) 0%, var(--paper) 58%, var(--sand) 66%, color-mix(in srgb, var(--sand) 50%, transparent) 74%, transparent 84%);
  }
  .stage__ring {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  /* the ring fades in once GLB, polished finish and S01 env are ready (D-083); after that the
     story drives opacity directly */
  :global(html.ring-live) .stage__ring {
    transition: none;
  }
  .stage__scenes {
    position: absolute;
    inset: 0;
    height: 100svh;
    outline: none;
  }
</style>
