---
/**
 * 23:00 — the close. The stone at night is the field; the ring comes down to rest on it
 * as you scroll, echoing the morning hero.
 */
import Button from './Button.astro';
import Img from './Img.astro';
import { close } from '../content/home';
import night from '../../../design/assets/v1/home/user/H-04-night-bg.png';
import ring from '../../../design/assets/v1/home/user/H-05-ring-night-cutout-crop.png';
import { Image } from 'astro:assets';
---

<section class="chapter close" id="night" data-chapter data-time="23:00" data-theme="dark" data-field="#0E1220" aria-labelledby="close-title">
  <div class="close__stage" aria-hidden="true">
    <Img src={night} alt="" sizes="max(100vw, 177svh)" widths={[1280, 1920, 2508]} />
  </div>
  <div class="close__stage close__stage--front">
    <div class="close__ring" data-close-ring>
      <Image src={ring} alt={close.alt} width={604} format="webp" quality={90} loading="lazy" />
    </div>
  </div>
  <canvas class="close__canvas" data-close-canvas aria-hidden="true"></canvas>

  <div class="close__text frame">
    <h2 class="close__title" id="close-title" data-split aria-label={close.heading.join(' ')}>
      {close.heading.map((l) => <span class="line" aria-hidden="true"><span class="line__inner">{l}</span></span>)}
    </h2>
    <p class="close__body" data-reveal>{close.body}</p>
    <div class="close__actions" data-reveal>
      <Button href={close.cta.href} label={close.cta.label} variant="paper" />
      <p class="close__note">{close.note}</p>
    </div>
  </div>
</section>
