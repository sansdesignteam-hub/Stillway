---
import Img from './Img.astro';
import { daylight as d } from '../content/home';
import s0740 from '../../../design/assets/v1/home/S3p-0740-moving-walk.png';
import s0900 from '../../../design/assets/v1/home/S3p-0900-resting-focus.png';
import s1030 from '../../../design/assets/v1/home/S3p-1030-moving-stretch.png';
import s1230 from '../../../design/assets/v1/home/S3p-1230-resting-lunch.png';
import s1530 from '../../../design/assets/v1/home/S3p-1530-moving-stairs.png';

const srcs = { s0740, s0900, s1030, s1230, s1530 } as const;
const first = d.frames[0];
---

<section class="chapter activity field-umber" id="day" data-chapter data-theme="dark" data-field="#1E1915" aria-labelledby="day-title">
  <div class="activity__track" data-activity style={`--frames: ${d.frames.length}`}>
    <span class="time-marker time-marker--start" data-time={d.timeFrom} aria-hidden="true"></span>
    <span class="time-marker time-marker--end" data-time={d.timeTo} aria-hidden="true"></span>

    <div class="activity__stage">
      <div class="activity__head frame">
        <h2 class="activity__title" id="day-title" data-split aria-label={d.heading.join(' ')}>
          <span class="line" aria-hidden="true"><span class="line__inner activity__muted">{d.heading[0]}</span></span>
          <span class="line" aria-hidden="true"><span class="line__inner">{d.heading[1]}</span></span>
        </h2>
        <p class="activity__body" data-reveal>{d.body}</p>
      </div>

      <div class="activity__frame" aria-hidden="true"></div>

      <ol class="activity__items" data-activity-items>
        {d.frames.map((f, i) => (
          <li class="activity__item" data-activity-item={i} >
            <Img src={srcs[f.key as keyof typeof srcs]} alt={f.alt} sizes="(max-width: 760px) 72vw, 32vw" widths={[480, 768, 1080]} />
            <span class="visually-hidden">{f.time}, {f.state}, {f.detail} (simulated).</span>
          </li>
        ))}
      </ol>

      <div class="activity__now frame" aria-hidden="true" data-reveal>
        <p class="activity__time" data-activity-time>{first.time}</p>
        <p class="activity__state"><i class="key" data-activity-key data-state={first.state} /><span data-activity-state>{first.state}</span></p>
        <p class="activity__detail" data-activity-detail>{first.detail}</p>
        <p class="activity__sim">{d.sim}</p>
      </div>

      <div class="activity__progress frame" aria-hidden="true">
        {d.frames.map((f, i) => (
          <span class="activity__tick" data-activity-tick={i}>{f.time}</span>
        ))}
      </div>
    </div>
  </div>
</section>
