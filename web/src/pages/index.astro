---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Rhythm from '../components/Rhythm.astro';
import Daylight from '../components/Daylight.astro';
import Insight from '../components/Insight.astro';
import RingDetails from '../components/RingDetails.astro';
import Finishes from '../components/Finishes.astro';
import Faq from '../components/Faq.astro';
import Close from '../components/Close.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Rhythm />
    <Daylight />
    <Insight />
    <RingDetails />
    <Finishes />
    <Faq />
    <Close />
  </main>
  <Footer />
</Base>

<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
